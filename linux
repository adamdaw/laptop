#!/usr/bin/env bash
# Bootstrap a Pop_OS 24.04 / Ubuntu 24.04 development machine.
# Idempotent: safe to re-run.
#
# Personal additions (name, email, private repos, bin symlinks) go in
# ~/.laptop.local — sourced at the end of this script.

set -euo pipefail

DOTFILES_REPO="https://github.com/adamdaw/dotfiles.git"
DOTFILES_DIR="$HOME/Projects/Home/dotfiles"
HOME_PROJECTS_DIR="$HOME/Projects/Home"

# ── Helpers ──────────────────────────────────────────────────────────────────

step() { printf "\n\033[1;34m==>\033[0m %s\n" "$1"; }
ok()   { printf "  \033[1;32m✓\033[0m %s\n" "$1"; }

cmd_exists() { command -v "$1" &>/dev/null; }

apt_install() {
  for pkg in "$@"; do
    if dpkg -s "$pkg" &>/dev/null 2>&1; then
      ok "$pkg already installed"
    else
      sudo apt-get install -y "$pkg"
      ok "installed $pkg"
    fi
  done
}

clone_if_absent() {
  local repo="$1" dir="$2"
  if [ -d "$dir/.git" ]; then
    ok "$(basename "$dir") already cloned"
  else
    git clone "$repo" "$dir"
    ok "cloned $(basename "$dir")"
  fi
}

symlink_bin() {
  local target="$1" link="$2"
  if [ -L "$link" ]; then
    ok "$(basename "$link") symlink already exists"
  else
    ln -s "$target" "$link"
    ok "linked $(basename "$link")"
  fi
}

# ── System update ─────────────────────────────────────────────────────────────

step "Updating system packages"
sudo apt-get update -qq
sudo apt-get upgrade -y

# ── Core apt packages ─────────────────────────────────────────────────────────

step "Installing core packages"
apt_install \
  build-essential \
  curl \
  wget \
  git \
  git-delta \
  stow \
  zsh \
  neovim \
  jq \
  ripgrep \
  fd-find \
  fzf \
  bat \
  xclip \
  zsh-autosuggestions \
  zsh-syntax-highlighting

# ── gh CLI ───────────────────────────────────────────────────────────────────

step "Installing gh CLI"
if cmd_exists gh; then
  ok "gh already installed ($(gh --version | head -1))"
else
  curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg
  sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
  sudo apt-get update -qq
  sudo apt-get install -y gh
  ok "installed gh"
fi

# ── fnm + Node ────────────────────────────────────────────────────────────────

step "Installing fnm + Node LTS"
FNM_BIN="$HOME/.local/share/fnm/fnm"
if [ -x "$FNM_BIN" ]; then
  ok "fnm already installed ($("$FNM_BIN" --version))"
else
  curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell
  ok "installed fnm"
fi
eval "$("$FNM_BIN" env --shell bash)"
if "$FNM_BIN" list 2>/dev/null | grep -q "lts"; then
  ok "node lts already installed via fnm"
else
  "$FNM_BIN" install --lts
  "$FNM_BIN" default lts-latest
  ok "installed node $(node --version)"
fi

# ── Claude Code ───────────────────────────────────────────────────────────────

step "Installing Claude Code"
if cmd_exists claude; then
  ok "claude already installed"
else
  npm install -g @anthropic-ai/claude-code
  ok "installed claude"
fi

# ── Bun ──────────────────────────────────────────────────────────────────────

step "Installing Bun"
if [ -x "$HOME/.bun/bin/bun" ]; then
  ok "bun already installed ($("$HOME/.bun/bin/bun" --version))"
else
  curl -fsSL https://bun.sh/install | bash
  ok "installed bun"
fi

# ── uv (Python package manager) ───────────────────────────────────────────────

step "Installing uv"
if cmd_exists uv; then
  ok "uv already installed"
else
  curl -LsSf https://astral.sh/uv/install.sh | sh
  ok "installed uv"
fi

# ── Starship ─────────────────────────────────────────────────────────────────

step "Installing Starship prompt"
if cmd_exists starship; then
  ok "starship already installed"
else
  curl -sS https://starship.rs/install.sh | sh -s -- --yes
  ok "installed starship"
fi

# ── JetBrains Mono Nerd Font ─────────────────────────────────────────────────

step "Installing JetBrains Mono Nerd Font"
FONT_DIR="$HOME/.local/share/fonts"
if fc-list | grep -qi "JetBrainsMono Nerd"; then
  ok "JetBrains Mono Nerd Font already installed"
else
  mkdir -p "$FONT_DIR"
  curl -fsSL https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip \
    -o /tmp/JetBrainsMono.zip
  unzip -o /tmp/JetBrainsMono.zip -d "$FONT_DIR/JetBrainsMono" '*.ttf' 2>/dev/null
  fc-cache -f "$FONT_DIR"
  rm /tmp/JetBrainsMono.zip
  ok "installed JetBrains Mono Nerd Font"
fi

# ── Ghostty ──────────────────────────────────────────────────────────────────

step "Installing Ghostty"
if cmd_exists ghostty; then
  ok "ghostty already installed ($(ghostty --version | head -1))"
else
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/mkasberg/ghostty-ubuntu/HEAD/install.sh)"
  ok "installed ghostty"
fi

# ── Telemetry opt-outs ────────────────────────────────────────────────────────

step "Disabling telemetry"
if cmd_exists ubuntu-report; then
  ubuntu-report send no 2>/dev/null || true
fi
if dpkg -s popularity-contest &>/dev/null 2>&1; then
  sudo apt-get remove -y popularity-contest
fi
sudo systemctl disable apport 2>/dev/null || true
if cmd_exists go; then
  go telemetry off 2>/dev/null || true
fi
npm config set fund false 2>/dev/null || true
ok "telemetry disabled"

# ── git config ────────────────────────────────────────────────────────────────

step "Configuring git"
git config --global core.hooksPath "$HOME/.config/git/hooks"
git config --global core.pager delta
git config --global interactive.diffFilter "delta --color-only"
git config --global delta.navigate true
git config --global delta.side-by-side true
git config --global pull.rebase true
git config --global push.autoSetupRemote true
git config --global init.defaultBranch main
git config --global merge.conflictstyle diff3
git config --global diff.colorMoved default
ok "git configured (identity set via ~/.gitconfig.local)"

# ── SSH ───────────────────────────────────────────────────────────────────────

step "SSH setup"
mkdir -p ~/.ssh && chmod 700 ~/.ssh
if [ ! -f ~/.ssh/id_ed25519 ]; then
  ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -N ""
  ok "generated ~/.ssh/id_ed25519"
  echo ""
  echo "  Add this public key to GitHub (or wherever needed):"
  cat ~/.ssh/id_ed25519.pub
  echo ""
else
  ok "SSH key already exists"
fi

# ── Dotfiles ──────────────────────────────────────────────────────────────────

step "Cloning and applying dotfiles"
mkdir -p "$HOME_PROJECTS_DIR"
clone_if_absent "$DOTFILES_REPO" "$DOTFILES_DIR"

cd "$DOTFILES_DIR"
for pkg in bash zsh git ssh ghostty starship nvim bin ripgrep bat; do
  stow --adopt --restow --target="$HOME" "$pkg" 2>/dev/null && ok "stowed $pkg" || true
done

# ── Shell ─────────────────────────────────────────────────────────────────────

step "Setting zsh as default shell"
if [ "$SHELL" = "$(which zsh)" ]; then
  ok "zsh is already the default shell"
else
  chsh -s "$(which zsh)"
  ok "default shell set to zsh (takes effect on next login)"
fi

# ── Personal additions ────────────────────────────────────────────────────────

if [ -f ~/.laptop.local ]; then
  step "Running ~/.laptop.local"
  source ~/.laptop.local
else
  printf "\n  No ~/.laptop.local found — skipping personal additions.\n"
  printf "  Create one to clone private repos, add bin symlinks, etc.\n"
fi

# ── Done ──────────────────────────────────────────────────────────────────────

printf "\n\033[1;32mDone.\033[0m Log out and back in to start using zsh.\n\n"
