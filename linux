install_debian() {
  step "Updating system packages"
  run sudo apt-get update -qq
  run sudo apt-get upgrade -y

  step "Installing core packages"
  apt_install \
    build-essential \
    curl \
    gpg \
    wget \
    git \
    git-delta \
    stow \
    zsh \
    neovim \
    jq \
    ripgrep \
    fd-find \
    fzf \
    bat \
    xclip \
    openjdk-21-jdk \
    zsh-autosuggestions \
    zsh-syntax-highlighting

  step "Installing gh CLI"
  if cmd_exists gh; then
    ok "gh already installed ($(gh --version | head -1))"
  else
    run_sh "curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg"
    run sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
    run_sh "echo \"deb [arch=\$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main\" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null"
    run sudo apt-get update -qq
    run sudo apt-get install -y gh
    did "installed gh"
  fi

  step "Installing mise"
  if [ -n "$(find_mise)" ]; then
    ok "mise already installed ($(find_mise))" # not run: mise creates state
  else
    # mise's official apt repo: signed packages that `apt-get upgrade` keeps
    # current, set up the same way as the gh repo above.
    run sudo install -dm 755 /etc/apt/keyrings
    # The key is dearmored to a temp file first, so a failed download never
    # leaves an empty keyring behind; both files are made apt-readable (0644).
    run_sh "tmp=\$(mktemp) && trap 'rm -f \"\$tmp\"' EXIT && curl -fsSL https://mise.jdx.dev/gpg-key.pub | gpg --dearmor > \"\$tmp\" && sudo install -m 644 \"\$tmp\" /etc/apt/keyrings/mise-archive-keyring.gpg"
    run_sh "echo \"deb [signed-by=/etc/apt/keyrings/mise-archive-keyring.gpg arch=\$(dpkg --print-architecture)] https://mise.jdx.dev/deb stable main\" | sudo tee /etc/apt/sources.list.d/mise.list > /dev/null"
    run sudo chmod 644 /etc/apt/sources.list.d/mise.list
    run sudo apt-get update -qq
    run sudo apt-get install -y mise
    did "installed mise"
  fi
  install_node
  install_claude
  install_bun

  step "Installing uv"
  if cmd_exists uv; then
    ok "uv already installed"
  else
    run_sh "curl -LsSf https://astral.sh/uv/install.sh | sh"
    did "installed uv"
  fi

  step "Installing Starship prompt"
  if cmd_exists starship; then
    ok "starship already installed"
  else
    run_sh "curl -sS https://starship.rs/install.sh | sh -s -- --yes"
    did "installed starship"
  fi

  install_font

  step "Installing Ghostty"
  if cmd_exists ghostty; then
    ok "ghostty already installed ($(ghostty --version | head -1))"
  else
    run_sh "/bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/mkasberg/ghostty-ubuntu/HEAD/install.sh)\""
    did "installed ghostty"
  fi

  step "Disabling telemetry"
  if cmd_exists ubuntu-report; then
    run ubuntu-report send no 2>/dev/null || true
  fi
  if dpkg -s popularity-contest &>/dev/null 2>&1; then
    run sudo apt-get remove -y popularity-contest
  fi
  run sudo systemctl disable apport 2>/dev/null || true
  if cmd_exists go; then
    run go telemetry off 2>/dev/null || true
  fi
  npm_no_fund
  ok "telemetry disabled"

  setup_ssh
  apply_dotfiles
  configure_git

  step "Setting zsh as default shell"
  local zsh_path
  zsh_path="$(command -v zsh || echo /usr/bin/zsh)"
  if [ "${SHELL:-}" = "$zsh_path" ]; then
    ok "zsh is already the default shell"
  else
    run chsh -s "$zsh_path"
    did "default shell set to zsh (takes effect on next login)"
  fi
}

# ── Bazzite / Fedora Atomic ──────────────────────────────────────────────────
# Install-order rule: ujust recipe (only if it does exactly the job and leaves
# stowed files alone) > Homebrew (CLI) > Flatpak (GUI) > rpm-ostree (last resort).
# /usr is read-only, so nothing here uses sudo, apt, chsh or system keyrings.

ensure_brew() {
  if cmd_exists brew; then
    return 0
  fi
  local dir
  for dir in $BREW_DIRS; do
    if [ -x "$dir/bin/brew" ]; then
      eval "$("$dir/bin/brew" shellenv)"
      return 0
    fi
  done
  if (( DRY_RUN )); then
    warn "Homebrew not found — a real run stops here. Bazzite ships it; otherwise install it from https://brew.sh first"
    BREW_MISSING=1
    return 0
  fi
  die "Homebrew not found. Bazzite ships it; otherwise install it from https://brew.sh and re-run."
}

install_brew_formulae() {
  step "Installing CLI tools with Homebrew"
  local entry formula bin missing=()
  for entry in "${BREW_FORMULAE[@]}"; do
    formula="${entry%%:*}"
    bin="${entry#*:}"
    if (( BREW_MISSING )); then
      missing+=("$formula") # only reachable under --dry-run
    elif brew list --formula --versions "$formula" &>/dev/null; then
      ok "$formula already installed (brew)"
    elif [ -n "$bin" ] && cmd_exists "$bin"; then
      ok "$formula provided by the system ($(command -v "$bin")) — skipping"
    else
      missing+=("$formula")
    fi
  done
  if (( ${#missing[@]} )); then
    run brew install "${missing[@]}"
    did "installed ${missing[*]}"
  fi
}

# Which deployment in `rpm-ostree status --json` ($2) layers package $1:
# prints "booted", "pending" (a staged/pending deployment newer than the booted
# one) or nothing. Rollback deployments (older than the booted one) don't count.
# If the JSON cannot be read, prints nothing, so the caller falls back to
# `rpm-ostree install --idempotent`, which is a no-op for requested packages.
deployment_with() {
  cmd_exists python3 || return 0
  python3 -c '
import json, sys
pkg = sys.argv[1]
try:
    deps = json.load(sys.stdin)["deployments"]
    assert isinstance(deps, list) and all(isinstance(d, dict) for d in deps)
except Exception:
    sys.exit(0)
booted = next((i for i, d in enumerate(deps) if d.get("booted")), None)
if booted is None:
    sys.exit(0)
def has(d):
    return pkg in (d.get("requested-packages") or []) + (d.get("packages") or [])
if has(deps[booted]):
    print("booted")
elif any(has(d) for d in deps[:booted]):
    print("pending")
' "$1" <<<"$2" 2>/dev/null || true
}

# Layer LAYERED_PACKAGES in one rpm-ostree transaction. Never reboots.
layer_packages() {
  step "Layering packages with rpm-ostree (${LAYERED_PACKAGES[*]})"
  local pkg status_json where pending=()
  status_json="$(rpm-ostree status --json 2>/dev/null || true)"
  for pkg in "${LAYERED_PACKAGES[@]}"; do
    where="$(deployment_with "$pkg" "$status_json")"
    if rpm -q "$pkg" &>/dev/null || cmd_exists "$pkg" || [ "$where" = booted ]; then
      ok "$pkg already installed"
    elif [ "$where" = pending ]; then
      ok "$pkg already layered — active after the next reboot"
      REBOOT_PKGS+=("$pkg")
    else
      pending+=("$pkg")
    fi
  done
  if (( ! ${#pending[@]} )); then
    return 0
  fi
  if ! compgen -G "$YUM_REPOS_DIR/terra*.repo" >/dev/null; then
    warn "Terra repo not found in $YUM_REPOS_DIR — rpm-ostree may not find: ${pending[*]}"
  fi
  if run rpm-ostree install --idempotent "${pending[@]}"; then
    REBOOT_PKGS+=("${pending[@]}")
    did "layered ${pending[*]}"
  else
    warn "rpm-ostree install failed for: ${pending[*]}. If the error mentions Terra metadata or checksum mismatches, a mirror is stale: run 'rpm-ostree refresh-md --force' and re-run this script. Not retrying automatically."
  fi
}

install_atomic() {
  step "System update"
  ok "skipped — Bazzite updates its image itself (run 'ujust update' to force)"

  ensure_brew
  install_brew_formulae

  install_node
  install_claude
  install_bun

  install_font
  layer_packages

  step "Disabling telemetry"
  if cmd_exists go; then
    run go telemetry off 2>/dev/null || true
  fi
  npm_no_fund
  ok "telemetry disabled"

  setup_ssh
  prepare_default_terminal
  apply_dotfiles
  configure_default_terminal
  configure_git

  step "Login shell"
  ok "login shell stays bash (no chsh on Bazzite); Ghostty starts zsh via its 'command =' setting"
  local ghostty_conf
  for ghostty_conf in "$DOTFILES_DIR"/ghostty/.config/ghostty/config*; do
    if [ -f "$ghostty_conf" ] && ! grep -Eq '^[[:space:]]*command[[:space:]]*=' "$ghostty_conf"; then
      warn "${ghostty_conf#"$DOTFILES_DIR"/} has no 'command =' line — add 'command = ${HOMEBREW_PREFIX:-/home/linuxbrew/.linuxbrew}/bin/zsh' in dotfiles"
    fi
  done
}

# ── Main ─────────────────────────────────────────────────────────────────────

main() {
  local print_os=0 arg os
  for arg in "$@"; do
    case "$arg" in
      -n|--dry-run) DRY_RUN=1 ;;
      --print-os)   print_os=1 ;;
      -h|--help)    usage; exit 0 ;;
      *)            usage >&2; die "unknown option: $arg" ;;
    esac
  done

  os="$(detect_os)"
  if (( print_os )); then
    echo "$os"
    return 0
  fi
  if (( DRY_RUN )); then
    printf "\033[1;33mDry run:\033[0m printing the plan; nothing will be changed.\n"
  fi

  case "$os" in
    debian) printf "Detected Debian/Ubuntu/Pop!_OS — using apt.\n"; install_debian ;;
    atomic) printf "Detected Bazzite / Fedora Atomic — using Homebrew, rpm-ostree only for: %s\n" "${LAYERED_PACKAGES[*]}"; install_atomic ;;
    *)      die "unsupported platform (${os#unsupported:}); supported: Ubuntu/Pop!_OS/Debian, Bazzite/Fedora Atomic" ;;
  esac

  run_local
  check_git_identity
  summary

  if (( ! DRY_RUN )); then
    if [ "$os" = debian ]; then
      printf "\n\033[1;32mDone.\033[0m Log out and back in to start using zsh.\n\n"
    else
      printf "\n\033[1;32mDone.\033[0m Open Ghostty to start using zsh.\n\n"
    fi
  fi
}

main "$@"
