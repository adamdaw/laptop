#!/usr/bin/env bash
# Bootstrap a development machine. Supported platforms:
#   - Pop_OS 24.04 / Ubuntu 24.04 / Debian      (apt)
#   - Bazzite / Fedora Atomic (ostree-booted)   (Homebrew > Flatpak > rpm-ostree)
# Idempotent: safe to re-run. `--dry-run` prints the plan without changing anything.
#
# Personal additions (name, email, private repos, bin symlinks) go in
# ~/.laptop.local — sourced at the end of this script.

set -euo pipefail

DOTFILES_REPO="https://github.com/adamdaw/dotfiles.git"
DOTFILES_DIR="$HOME/Projects/Home/dotfiles"
HOME_PROJECTS_DIR="$HOME/Projects/Home"

# Overridable so the test harness can point detection at fixtures.
OS_RELEASE_FILE="${LAPTOP_OS_RELEASE:-/etc/os-release}"
OSTREE_BOOTED_FILE="${LAPTOP_OSTREE_BOOTED:-/run/ostree-booted}"
YUM_REPOS_DIR="${LAPTOP_YUM_REPOS_DIR:-/etc/yum.repos.d}"
# Where to look for Homebrew when `brew` is not on PATH (space-separated).
BREW_DIRS="${LAPTOP_BREW_DIRS:-/home/linuxbrew/.linuxbrew $HOME/.linuxbrew}"
CPUINFO_FILE="${LAPTOP_CPUINFO:-/proc/cpuinfo}"
# Where to look for the Vulkan loader when ldconfig does not list it (space-separated).
VULKAN_LIB_DIRS="${LAPTOP_LIB_DIRS:-/usr/lib64 /usr/lib/x86_64-linux-gnu /usr/lib /lib64 /lib/x86_64-linux-gnu /lib}"

# voxtype (speech-to-text; the dotfiles `transcribe` wrapper runs it): the
# upstream standalone release binary, pinned, and the key that signs each
# release's SHA256SUMS.txt.
VOXTYPE_VERSION=1.1.0
VOXTYPE_RELEASE="https://github.com/peteonrails/voxtype/releases/download/v$VOXTYPE_VERSION"
VOXTYPE_KEY_FPR=9CCF7915B750CAE8B095ED1AA3FC9F33FD209279 # gitleaks:allow (a public key's fingerprint, not a secret)
VOXTYPE_KEY_URL="https://keys.openpgp.org/vks/v1/by-fingerprint/$VOXTYPE_KEY_FPR"
VOXTYPE_MODEL=large-v3-turbo

# Neovim for the dotfiles nvim package. NEOVIM_MIN is what that config needs:
# the nvim-treesitter revision its lazy-lock.json pins (the `main` branch)
# requires 0.12. apt's is older (Ubuntu 24.04: 0.9.5), so Debian/Ubuntu get the
# upstream release tarball, pinned. Neovim publishes no signed checksum file,
# so the tarball's SHA256 is pinned here (overridable so the test harness can
# serve a fixture tarball).
NEOVIM_MIN=0.12.0
NEOVIM_VERSION=0.12.5
NEOVIM_ASSET=nvim-linux-x86_64.tar.gz
NEOVIM_RELEASE="https://github.com/neovim/neovim/releases/download/v$NEOVIM_VERSION"
NEOVIM_SHA256="${LAPTOP_NEOVIM_SHA256:-bce0f56eda1f1b1db6eee8f4133d7a38813ea07933837dd1777411ca384c6875}"

# Dotfiles packages to stow (one directory each in the dotfiles repo).
STOW_PACKAGES=(agy applications atuin bash bat bin claude ghostty git nvim render-url ripgrep ssh starship tmux zsh)
# Stowed with --no-folding: their target dirs (~/bin, ~/.local/bin,
# ~/.local/share/..., ~/.config, ~/.config/agy, ~/.config/atuin,
# ~/.config/atuin-ai-server, ~/.config/containers/systemd, ~/.claude) must stay
# real directories, so nothing written there (scripts other installers drop
# into ~/bin, agy's and atuin's own files, other Quadlet units, render-url's
# node_modules, Claude Code's sessions and credentials, other apps' files)
# ever lands in the dotfiles repo.
NO_FOLD_PACKAGES=(agy applications atuin bin claude render-url xdg)

# Existing files that conflict with a stowed file are moved into a fresh,
# uniquely named directory under here (created on first use), never adopted.
BACKUP_ROOT="$HOME/.local/state/laptop/backups"
BACKUP_DIR=""

# The line `ujust bazzite-cli` appends to ~/.bashrc / ~/.zshrc.
BLING_PATTERN='ublue-os/bling|bling\.sh'

# Bazzite / Fedora Atomic: CLI tools from Homebrew, as "formula:command".
# The command is used to skip anything the image already provides (e.g. tmux,
# git); an empty command means "check brew only".
BREW_FORMULAE=(
  git:git
  git-delta:delta
  stow:stow
  neovim:nvim
  tmux:tmux
  jq:jq
  ripgrep:rg
  fd:fd
  fzf:fzf
  bat:bat
  wget:wget
  gh:gh
  starship:starship
  zsh:zsh
  zsh-autosuggestions:
  zsh-syntax-highlighting:
  uv:uv
  mise:mise
  openjdk@21: # keg-only; a system java does not prove JDK 21 is installed
  lazygit:lazygit
  tree-sitter-cli:tree-sitter
  shellcheck:shellcheck
  markdownlint-cli2:markdownlint-cli2
  gitleaks: # dotfiles' pre-commit hook needs >= 8.20.0; a system copy may be older
  atuin:atuin
)

# Bazzite / Fedora Atomic: GUI apps come from Flatpak — none are needed yet.

# Bazzite / Fedora Atomic: packages layered with rpm-ostree. Last resort only:
# every entry must say why neither Homebrew nor Flatpak can provide it.
LAYERED_PACKAGES=(
  ghostty # no Flatpak exists and the Homebrew formula is macOS-only; Terra (enabled on Bazzite) packages it
)

DEFAULT_TERMINAL=0
XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-}"
DRY_RUN=0
BREW_MISSING=0
BACKUPS=()
WARNINGS=()
REBOOT_PKGS=()

# Machine-local git settings (identity, credentials) live here; the dotfiles
# .gitconfig includes it.
GIT_LOCAL="$HOME/.gitconfig.local"
# Under --dry-run only: the last value of each key that would be copied into
# $GIT_LOCAL, to predict the identity. A real run reads the files instead.
declare -A GIT_PLANNED=()
# The temp file a migration is building, removed by a trap if interrupted.
GIT_LOCAL_TMP=""
# 1 once the dotfiles git package is stowed (under --dry-run: would be).
GIT_STOWED=0
# 1 once the dotfiles render-url package is stowed (under --dry-run: would be).
RENDER_URL_STOWED=0
# 1 once the dotfiles atuin package is stowed (under --dry-run: would be).
ATUIN_STOWED=0

# ── Helpers ──────────────────────────────────────────────────────────────────

step() { printf "\n\033[1;34m==>\033[0m %s\n" "$1"; }
ok()   { printf "  \033[1;32m✓\033[0m %s\n" "$1"; }
warn() { printf "  \033[1;33m!\033[0m %s\n" "$1"; WARNINGS+=("$1"); }
die()  { printf "\033[1;31merror:\033[0m %s\n" "$1" >&2; exit 1; }

cmd_exists() { command -v "$1" &>/dev/null; }

# Run a command, or only print it under --dry-run.
run() {
  if (( DRY_RUN )); then
    printf "  \033[2m[dry-run]\033[0m %s\n" "$*"
    return 0
  fi
  "$@"
}

# Same as run, for a shell pipeline passed as one string. The child shell gets
# the same -e -u -o pipefail as this script, so `curl ... | sh` fails when curl does.
run_sh() {
  if (( DRY_RUN )); then
    printf "  \033[2m[dry-run]\033[0m %s\n" "$1"
    return 0
  fi
  bash -euo pipefail -c "$1"
}

# Print a success message only when something actually happened.
did() { (( DRY_RUN )) || ok "$1"; }

usage() {
  cat <<'EOF'
Usage: linux [--dry-run] [--print-os]

  -n, --dry-run   Print what would be done; change nothing.
      --print-os  Print the detected platform (debian | atomic) and exit.
  -h, --help      Show this help.
EOF
}

apt_install() {
  for pkg in "$@"; do
    if dpkg -s "$pkg" &>/dev/null 2>&1; then
      ok "$pkg already installed"
    else
      run sudo apt-get install -y "$pkg"
      did "installed $pkg"
    fi
  done
}

clone_if_absent() {
  local repo="$1" dir="$2"
  if [ -d "$dir/.git" ]; then
    ok "$(basename "$dir") already cloned"
  else
    run git clone "$repo" "$dir"
    did "cloned $(basename "$dir")"
  fi
}

symlink_bin() {
  local target="$1" link="$2"
  if [ -L "$link" ]; then
    ok "$(basename "$link") symlink already exists"
  else
    run ln -s "$target" "$link"
    did "linked $(basename "$link")"
  fi
}

# ── Platform detection ───────────────────────────────────────────────────────

# Prints "debian", "atomic" (Bazzite / Fedora Atomic) or "unsupported:<ID>".
detect_os() {
  local id="" id_like="" line
  if [ -r "$OS_RELEASE_FILE" ]; then
    while IFS= read -r line; do
      case "$line" in
        ID=*)      id="${line#ID=}" ;;
        ID_LIKE=*) id_like="${line#ID_LIKE=}" ;;
      esac
    done < "$OS_RELEASE_FILE"
  fi
  id="${id//\"/}"
  id_like=" ${id_like//\"/} "

  if [ "$id" = bazzite ]; then
    echo atomic
  elif [ -e "$OSTREE_BOOTED_FILE" ] && { [ "$id" = fedora ] || [[ "$id_like" == *" fedora "* ]]; }; then
    echo atomic
  elif [[ "$id" =~ ^(ubuntu|pop|debian)$ ]] || [[ "$id_like" == *" ubuntu "* || "$id_like" == *" debian "* ]]; then
    echo debian
  else
    echo "unsupported:${id:-unknown}"
  fi
}

# ── Shared steps ─────────────────────────────────────────────────────────────

# mise's own directories, resolved the way mise resolves them.
mise_data_dir() { echo "${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"; }
mise_config_file() {
  if [ -n "${MISE_GLOBAL_CONFIG_FILE:-}" ]; then
    echo "$MISE_GLOBAL_CONFIG_FILE"
  else
    echo "${MISE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mise}/config.toml"
  fi
}

# Path of an installed mise (on PATH, or where mise's own installer puts it),
# or nothing. Never runs it: mise creates state and cache dirs whenever it runs.
find_mise() {
  if cmd_exists mise; then
    command -v mise
  elif [ -x "$HOME/.local/bin/mise" ]; then
    echo "$HOME/.local/bin/mise"
  fi
}

# What mise's global config file $1 says about node, parsed as real TOML with
# python3's tomllib (mise is not run). Prints one line, fields split by "|":
#   absent                  no file, or no tools.node entry: node may be pinned
#   pinned|VERSION|KEY      a tools.node (or tools."core:node") entry exists; VERSION
#                           is its version when it is one string, else empty
#   uncertain|REASON        can't tell (no python3/tomllib, unreadable or
#                           invalid file): never write the config
mise_node_pin() {
  local out
  if ! cmd_exists python3; then
    echo "uncertain|python3 not found"
    return 0
  fi
  out="$(python3 -I -c '
import os, sys
path = sys.argv[1]
def say(*fields):
    print("|".join(" ".join(str(f).split()) for f in fields))
    sys.exit(0)
if not os.path.lexists(path):
    say("absent")
try:
    import tomllib
except ImportError:
    say("uncertain", "python3 has no tomllib (needs Python 3.11+)")
try:
    with open(path, "rb") as f:
        data = tomllib.load(f)
except Exception as e:
    say("uncertain", "cannot parse it: %s" % e)
tools = data.get("tools", {})
if not isinstance(tools, dict):
    say("uncertain", "tools is not a table")
for key in ("node", "core:node"):
    if key in tools:
        v = tools[key]
        if isinstance(v, dict):
            v = v.get("version")
        say("pinned", v if isinstance(v, str) else "", key)
say("absent")
' "$1" 2>/dev/null)" || out=""
  case "$out" in
    absent|pinned\|*|uncertain\|*) echo "$out" ;;
    *) echo "uncertain|python3 could not read it" ;;
  esac
}

# True if mise's data dir $1 holds an executable node for version selection $2,
# found the way mise lays out installs: installs/node/<selection> (a version,
# or a prefix/alias symlink such as 22 or lts that mise makes), or for a
# numeric prefix, installs/node/<prefix>.*. Anything else is not proven.
node_installed() {
  local dir="$1/installs/node" sel="$2" d
  [[ "$sel" =~ ^[A-Za-z0-9._-]+$ && "$sel" != *..* ]] || return 1
  [ -x "$dir/$sel/bin/node" ] && return 0
  if [[ "$sel" =~ ^v?[0-9]+(\.[0-9]+)*$ ]]; then
    sel="${sel#v}"
    for d in "$dir/$sel".*; do
      [ -x "$d/bin/node" ] && return 0
    done
  fi
  return 1
}

# Why `mise use -g` must not write config file $1, or nothing if it may.
# Fails closed: a path that cannot be canonicalised is never written.
config_write_blocked() {
  local cfg repo
  if ! cfg="$(realpath -m -- "$1" 2>/dev/null)" || ! repo="$(realpath -m -- "$DOTFILES_DIR" 2>/dev/null)" ||
     [ -z "$cfg" ] || [ -z "$repo" ]; then
    echo "could not resolve mise's global config $1 or the dotfiles repo; not writing to it"
  elif [[ "$cfg" == "$repo"/* ]]; then
    # e.g. ~/.config is a link into the repo (a stow fold, or a dotfiles mise
    # package): `mise use -g` would write into the repo.
    echo "mise's global config $1 resolves into the dotfiles repo; not writing to it"
  fi
}

# Note (don't remove) a Node manager this script no longer installs.
note_old_fnm() {
  local where="${FNM_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/fnm}"
  if [ ! -d "$where" ]; then
    where="$(command -v fnm)" || return 0
  fi
  printf "  \033[2mnote:\033[0m fnm is still installed (%s). Node now comes from mise; this script leaves fnm alone — remove it by hand when you no longer need it.\n" "$where"
}

# npm of the mise-managed Node, once that Node is known to be usable (under
# --dry-run: once it is installed or planned). Empty means no usable Node, so
# nothing that needs npm runs — never some other npm on PATH.
NODE_NPM=""

# Node LTS through mise. `mise use -g node@lts` pins it in mise's global config
# (~/.config/mise/config.toml by default) and installs it. An existing pin, of
# any form, is never changed, and the config is only written when it is
# confirmed to have no node entry.
MISE_BIN=""
install_node() {
  step "Installing Node LTS via mise"
  local config data shims pin state version key reason pinned mise_ok=0
  NODE_NPM=""
  MISE_BIN="$(find_mise)"
  config="$(mise_config_file)"
  data="$(mise_data_dir)"
  shims="$data/shims"
  if (( ! DRY_RUN )) && [ -z "$MISE_BIN" ]; then
    die "mise not found after installing it; cannot install Node"
  fi
  MISE_BIN="${MISE_BIN:-mise}"
  # Decided from files on disk, never by running mise (it creates state, so a
  # --dry-run must not run it), so a dry run and a real run agree.
  pin="$(mise_node_pin "$config")"
  IFS='|' read -r state version key <<<"$pin"
  pinned="tools.$key = ${version:-(version not derived)}"
  if [ "$state" = uncertain ]; then
    reason="$version"
    warn "can't tell whether mise's global config $config pins node ($reason); not changing it or installing Node. Fix it (or pin node yourself) and re-run"
  elif [ "$state" = pinned ] && node_installed "$data" "$version" && [ -x "$shims/node" ] && [ -x "$shims/npm" ]; then
    ok "node already installed via mise ($pinned in $config)"
    mise_ok=1
  elif [ "$state" = pinned ]; then
    # Pinned, but disk can't prove a matching, usable install (other version,
    # version not derived, no shims): reconcile through mise, don't re-pin.
    if ! run "$MISE_BIN" install node; then
      warn "'mise install node' failed ($pinned in $config)"
    elif ! run "$MISE_BIN" reshim; then
      warn "'mise reshim' failed after installing node; its node/npm shims may be missing"
    else
      mise_ok=1
      did "reconciled node with mise ($pinned in $config)"
    fi
  elif reason="$(config_write_blocked "$config")" && [ -n "$reason" ]; then
    warn "$reason. Add node = \"lts\" under [tools] there (or run 'mise use -g node@lts' yourself) and re-run"
  elif run "$MISE_BIN" use -g node@lts; then
    mise_ok=1
    did "installed node lts with mise (pinned in $config)"
  else
    warn "'mise use -g node@lts' failed"
  fi
  note_old_fnm
  if (( ! mise_ok )); then
    return 0
  elif (( DRY_RUN )); then
    NODE_NPM="$shims/npm"
  elif [ -x "$shims/node" ] && [ -x "$shims/npm" ]; then
    NODE_NPM="$shims/npm"
    # Put mise's node first for the following steps (npm's scripts run node).
    export PATH="$shims:$PATH"
  else
    warn "mise's node/npm shims are missing from $shims; Node is not usable"
  fi
}

# Optional Salesforce tools. All execution goes through mise's selected Node.
install_salesforce() {
  step "Installing Salesforce tools"
  local data package plugins
  local -a missing=()
  data="$(mise_data_dir)"
  if [ -z "$NODE_NPM" ]; then
    warn "skipped Salesforce tools: no usable mise-managed Node; fix Node and re-run"
    return 0
  fi
  if (( ! DRY_RUN )) && ! "$MISE_BIN" exec -- node --version >/dev/null 2>&1; then
    warn "skipped Salesforce tools: mise-managed Node is unusable; re-run once fixed"
    return 0
  fi
  for package in @salesforce/cli @salesforce/lwc-language-server; do
    # Dry-run must never execute mise, even for inspection (it writes state).
    if (( DRY_RUN )); then
      missing+=("$package")
    elif "$MISE_BIN" exec -- npm list -g --depth=0 "$package" >/dev/null 2>&1; then
      ok "$package already installed"
    else
      missing+=("$package")
    fi
  done
  if (( ${#missing[@]} )); then
    if ! run "$MISE_BIN" exec -- npm install -g "${missing[@]}"; then
      warn "Salesforce npm install failed; next run will retry"
      return 0
    fi
  fi
  # Repair missing shims too, without upgrading installed packages.
  if (( ${#missing[@]} )) || [ ! -x "$data/shims/sf" ] || [ ! -x "$data/shims/lwc-language-server" ]; then
    if ! run "$MISE_BIN" reshim; then
      warn "Salesforce mise reshim failed; next run will retry"
      return 0
    fi
  fi
  if (( ! DRY_RUN )); then
    if ! plugins="$("$MISE_BIN" exec -- sf plugins 2>/dev/null)"; then
      warn "Salesforce plugin listing failed; next run will retry"
      return 0
    fi
    if grep -Eq '^[[:space:]]*(@salesforce/plugin-)?code-analyzer[[:space:]]' <<<"$plugins"; then
      ok "Salesforce code-analyzer already installed"
      return 0
    fi
  fi
  if ! run "$MISE_BIN" exec -- sf plugins install code-analyzer; then
    warn "Salesforce code-analyzer install failed (requires Java 11+); next run will retry"
  fi
}

# Agent CLIs, as "npm package:command", installed globally with mise's npm.
AGENT_CLIS=(
  @anthropic-ai/claude-code:claude
  @openai/codex:codex
  @earendil-works/pi-coding-agent:pi
)
# Node's own tools, linked from ~/.local/bin to mise's shims. (pnpm is not one:
# it is enabled under Node LTS only, so it is linked there, like the CLIs.)
NODE_TOOLS=(node npm npx corepack)

# Run a command with Node LTS first on PATH (`mise exec node@lts`), or only
# print it under --dry-run. The first call says that mise may download Node
# LTS first (when its lts isn't installed, or a newer LTS is out).
LTS_NOTED=0
run_lts() {
  if (( ! LTS_NOTED )); then
    printf "  \033[2mnote:\033[0m 'mise exec node@lts' may download and install Node LTS first\n"
    LTS_NOTED=1
  fi
  run "$MISE_BIN" exec node@lts -- "$@"
}

# Link $2 (in ~/.local/bin) to $1, if $1 and every further argument (what the
# link needs to work) exist. Only a symlink is replaced; anything else there is
# backed up first, like any other conflict, never overwritten.
link_local_bin() {
  local target="$1" link="$2" rel="${2#"$HOME"/}" path
  if (( ! DRY_RUN )); then
    for path in "$target" "${@:3}"; do
      if [ ! -x "$path" ]; then
        warn "not linking ~/$rel: $path is missing"
        return 0
      fi
    done
  fi
  if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
    ok "already linked: ~/$rel -> $target"
    return 0
  fi
  if [ -e "$link" ] && [ ! -L "$link" ]; then
    backup_file "$link" "$rel" || return 0
  fi
  if run ln -sfn "$target" "$link"; then
    did "linked ~/$rel -> $target"
  else
    warn "could not link ~/$rel to $target"
  fi
}

# claude, codex and pi under mise's Node LTS, each installed only if its
# command is missing from Node LTS's bin dir (decided from disk, so a dry run
# and a real run agree), plus pnpm through corepack. Everything runs with Node
# LTS's own npm and corepack (`mise exec node@lts`), whatever node mise's
# config pins (never changed here), so install, check and links all use
# installs/node/lts. Omnigent starts
# claude/codex/pi with a renamed argv[0], which mise's shims reject, so their
# ~/.local/bin links point straight at Node LTS's bin dir, as pnpm's does (a
# shim follows the pin, whose node may have no pnpm); node, npm, npx and
# corepack link to mise's shims. Every failure is a warning.
install_agent_clis() {
  step "Installing agent CLIs (claude, codex, pi) and pnpm"
  local data lts_bin shims entry package tool changed=0
  if [ -z "$NODE_NPM" ]; then
    warn "skipped agent CLIs: no usable mise-managed Node (see above). Once Node works: npm install -g ${AGENT_CLIS[*]%%:*}"
    return 0
  fi
  data="$(mise_data_dir)"
  lts_bin="$data/installs/node/lts/bin"
  shims="$data/shims"
  if (( ! DRY_RUN )) && [ ! -d "$data/installs/node/lts" ]; then
    warn "skipped agent CLIs: mise has no Node LTS at $data/installs/node/lts, where they are linked from"
    return 0
  fi
  for entry in "${AGENT_CLIS[@]}"; do
    package="${entry%%:*}" tool="${entry#*:}"
    if [ -x "$lts_bin/$tool" ]; then
      ok "$tool already installed ($package)"
    elif run_lts npm install -g "$package"; then
      changed=1
      did "installed $tool ($package)"
    else
      warn "'npm install -g $package' failed; next run will retry"
    fi
  done
  if [ -x "$lts_bin/pnpm" ]; then
    ok "pnpm already enabled"
  else
    # Node 25 and later no longer ship corepack: get it from npm. (Only known
    # once Node LTS is installed; a dry run on a fresh machine can't tell.)
    if [ -d "$lts_bin" ] && [ ! -x "$lts_bin/corepack" ]; then
      if run_lts npm install -g corepack; then
        changed=1
        did "installed corepack (Node LTS has none)"
      else
        warn "'npm install -g corepack' failed; next run will retry"
      fi
    fi
    if (( ! DRY_RUN )) && [ ! -x "$lts_bin/corepack" ]; then
      warn "skipped pnpm: Node LTS has no corepack ($lts_bin/corepack)"
    # corepack puts pnpm next to the first corepack on PATH; mise exec puts
    # Node LTS's bin dir first, so pnpm lands there, not among the shims.
    elif run_lts corepack enable pnpm; then
      changed=1
      did "enabled pnpm (corepack enable pnpm)"
    else
      warn "'corepack enable pnpm' failed; next run will retry"
    fi
  fi
  # npm and corepack put their commands in Node's bin dir; reshim gives them shims.
  for tool in "${NODE_TOOLS[@]}"; do
    [ -x "$shims/$tool" ] || changed=1
  done
  if (( changed )) && ! run "$MISE_BIN" reshim; then
    warn "'mise reshim' failed after installing agent CLIs; next run will retry"
  fi

  local dir="$HOME/.local/bin"
  if in_repo "$dir"; then
    warn "skipped ~/.local/bin links: $dir resolves into the dotfiles repo"
    return 0
  fi
  if [ ! -d "$dir" ] && ! run mkdir -p "$dir"; then
    warn "could not create $dir; not linking agent CLIs"
    return 0
  fi
  for tool in "${AGENT_CLIS[@]#*:}" pnpm; do
    link_local_bin "$lts_bin/$tool" "$dir/$tool"
  done
  for tool in "${NODE_TOOLS[@]}"; do
    # A shim alone proves nothing: it runs for any installed version.
    link_local_bin "$shims/$tool" "$dir/$tool" "$lts_bin/$tool"
  done
}

# npm settings, only through the mise-managed npm.
npm_no_fund() {
  if [ -n "$NODE_NPM" ]; then
    run "$NODE_NPM" config set fund false 2>/dev/null || true
  fi
}

install_bun() {
  step "Installing Bun"
  if [ -x "$HOME/.bun/bin/bun" ]; then
    ok "bun already installed ($("$HOME/.bun/bin/bun" --version))"
  else
    run_sh "curl -fsSL https://bun.sh/install | bash"
    did "installed bun"
  fi
}

# True if the font is already installed: its files are in the target dir, or
# fontconfig knows it. fc-list is captured first: `fc-list | grep -q` fails
# under pipefail when grep exits early and fc-list dies of SIGPIPE.
font_installed() {
  local font_dir="$1" f fonts
  for f in "$font_dir"/JetBrainsMono/*.ttf; do
    [ -f "$f" ] && return 0
  done
  fonts="$(fc-list 2>/dev/null)" || true
  grep -qi "JetBrainsMono Nerd" <<<"$fonts"
}

install_font() {
  step "JetBrains Mono Nerd Font"
  local font_dir="$HOME/.local/share/fonts"
  if font_installed "$font_dir"; then
    ok "JetBrains Mono Nerd Font already installed"
  else
    run_sh "tmp=\$(mktemp -d) && curl -fsSL https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip -o \"\$tmp/JetBrainsMono.zip\" && mkdir -p '$font_dir' && unzip -o \"\$tmp/JetBrainsMono.zip\" -d '$font_dir/JetBrainsMono' '*.ttf' >/dev/null && fc-cache -f '$font_dir' && rm -rf \"\$tmp\""
    did "installed JetBrains Mono Nerd Font"
  fi
}

# True if git config --global could write into the dotfiles repo: ~/.gitconfig
# or ~/.config/git/config resolves into it (a stowed file, or a link by hand).
global_config_in_repo() {
  local f repo
  repo="$(realpath -m -- "$DOTFILES_DIR")"
  for f in "$HOME/.gitconfig" "${XDG_CONFIG_HOME:-$HOME/.config}/git/config"; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    [[ "$(realpath -m -- "$f")" == "$repo"/* ]] && return 0
  done
  return 1
}

# Runs after apply_dotfiles. Once ~/.gitconfig is the stowed dotfiles file,
# its settings come from dotfiles: `git config --global` would write through
# the link into the repo. Before, it would write into a file about to be
# backed up. Only when the git package was not stowed, and no global config
# file resolves into the repo, are they set here.
configure_git() {
  step "Configuring git"
  if (( GIT_STOWED )) || global_config_in_repo; then
    ok "git settings come from the dotfiles .gitconfig (stowed; nothing written with --global)"
  else
    run git config --global core.hooksPath "$HOME/.config/git/hooks"
    run git config --global core.pager delta
    run git config --global interactive.diffFilter "delta --color-only"
    run git config --global delta.navigate true
    run git config --global delta.side-by-side true
    run git config --global pull.rebase true
    run git config --global push.autoSetupRemote true
    run git config --global init.defaultBranch main
    run git config --global merge.conflictstyle diff3
    run git config --global diff.colorMoved default
    did "git configured with --global (the dotfiles git package was not stowed)"
  fi
}

# Machine-local git settings that belong in ~/.gitconfig.local, not dotfiles.
is_local_git_key() {
  case "$1" in
    user.name|user.email|user.signingkey|credential.*) return 0 ;;
  esac
  return 1
}

# Print KEY's last value in FILE (nothing, and non-zero, if unset or unreadable).
git_get() { # git_get FILE KEY [--includes]
  [ -e "$1" ] && cmd_exists git || return 1
  git config --file "$1" ${3:+"$3"} --get "$2" 2>/dev/null
}

# KEY's value in the user's global git config after this run, resolved the
# way git does: ~/.config/git/config, then ~/.gitconfig (which wins), each
# with its includes; a key set but empty stays empty. (Not `git config
# --global`: with ~/.gitconfig present, git 2.5x reads only that file.)
# Under --dry-run, if ~/.gitconfig would be backed up, the dotfiles .gitconfig
# stands in for it, and a value that would be copied into ~/.gitconfig.local
# counts when nothing else sets the key.
git_identity_value() {
  local key="$1" val="" v f main="$HOME/.gitconfig"
  cmd_exists git || return 0
  if (( DRY_RUN )) && [ -n "${BACKED_UP[$HOME/.gitconfig]:-}" ] && [ -e "$DOTFILES_DIR/git/.gitconfig" ]; then
    main="$DOTFILES_DIR/git/.gitconfig"
  fi
  for f in "${XDG_CONFIG_HOME:-$HOME/.config}/git/config" "$main"; do
    if [ -e "$f" ] && v="$(git config --file "$f" --includes --get "$key" 2>/dev/null)"; then
      val="$v"
    fi
  done
  if [ -z "$val" ] && (( DRY_RUN )) && [ -n "${GIT_PLANNED[$key]+x}" ]; then
    val="${GIT_PLANNED[$key]}"
  fi
  printf '%s' "$val"
}

# Say where the git identity comes from, or warn (into the summary) that it
# is missing. Runs last, after ~/.laptop.local, which may set or clear it, and
# reads the final values; an empty value counts as missing.
check_git_identity() {
  # shellcheck disable=SC2088 # printed, not expanded
  local key val missing=() where="~/.gitconfig.local" hint=""
  step "git identity"
  for key in user.name user.email; do
    val="$(git_identity_value "$key")"
    if [ -z "$val" ]; then
      missing+=("$key")
    elif [ "$val" != "$(git_get "$GIT_LOCAL" "$key")" ] && [ "$val" != "${GIT_PLANNED[$key]:-}" ]; then
      where="the global git config"
    fi
  done
  if (( DRY_RUN )) && [ -f ~/.laptop.local ]; then
    hint=" (unless ~/.laptop.local sets it)"
  fi
  if (( ${#missing[@]} )); then
    warn "git identity is not set$hint (missing ${missing[*]}): set it with 'git config --file ~/.gitconfig.local user.name \"Your Name\"' and 'git config --file ~/.gitconfig.local user.email you@example.com'"
  elif (( DRY_RUN )); then
    ok "git identity will be set via $where"
  else
    ok "git identity set via $where"
  fi
}

# Refuse to migrate: warn why, and what to do by hand. ~/.gitconfig stays put
# and the git package is not stowed.
refuse_git_carry() {
  warn "$1 — not moving ~/.gitconfig and not stowing git. By hand: put user.name, user.email, user.signingkey and credential.* from ~/.gitconfig into ~/.gitconfig.local (a regular file), then move ~/.gitconfig away and re-run"
  return 1
}

# Before ~/.gitconfig is moved out of the way of the dotfiles one, copy its
# identity and credential settings into ~/.gitconfig.local, which the dotfiles
# .gitconfig includes. Every value of a multi-valued key is copied in order,
# empty values (a helper reset) included. A key already in ~/.gitconfig.local
# is never touched.
#
# All or nothing: the new file is built in a temp file next to it (a copy of
# the existing one plus the missing keys), checked value by value, and moved
# into place with mode 0600. On any failure the original is untouched.
#
# Refuses (returns non-zero with a warning, so ~/.gitconfig stays where it is)
# when it can't be done faithfully: git missing, a file unreadable,
# ~/.gitconfig using include/includeIf (flattening would change what applies
# where), ~/.gitconfig.local a symlink or not a regular file (never write
# through it), or a key to copy that has no value (git config can't write one).
# Prints key names only, never values.
carry_git_local() {
  local src="$HOME/.gitconfig" entry key val i n tmp
  local -a keys=() vals=() order=() todo=()
  local -A count=() bare=()
  cmd_exists git || refuse_git_carry "git not found; cannot copy identity/credentials to ~/.gitconfig.local" || return 1
  if [ -L "$GIT_LOCAL" ] || { [ -e "$GIT_LOCAL" ] && [ ! -f "$GIT_LOCAL" ]; }; then
    refuse_git_carry "not writing through ~/.gitconfig.local: it is a symlink or not a regular file" || return 1
  fi
  git config --file "$src" --list >/dev/null 2>&1 || refuse_git_carry "could not read ~/.gitconfig" || return 1
  if [ -e "$GIT_LOCAL" ] && ! git config --file "$GIT_LOCAL" --list >/dev/null 2>&1; then
    refuse_git_carry "could not read ~/.gitconfig.local" || return 1
  fi
  if git config --file "$src" --name-only --get-regexp '^include(if)?\.' >/dev/null 2>&1; then
    refuse_git_carry "not copying from ~/.gitconfig: it uses [include]/[includeIf], and flattening those would change what applies where" || return 1
  fi
  if [ -e "$GIT_LOCAL" ] && git config --file "$GIT_LOCAL" --name-only --get-regexp '^include(if)?\.' >/dev/null 2>&1; then
    refuse_git_carry "not copying into ~/.gitconfig.local: it uses [include]/[includeIf], so which keys it already has can't be told safely" || return 1
  fi
  # --null: entries end in NUL, key and value are split by a newline; a key
  # with no newline has no value (a bare key). A listing that fails, even
  # after partial output, aborts the migration.
  local -a entries=()
  mapfile -d '' entries < <(git config --file "$src" --null --list 2>/dev/null)
  wait "$!" || refuse_git_carry "could not list the settings in ~/.gitconfig" || return 1
  for entry in "${entries[@]}"; do
    key="${entry%%$'\n'*}"
    is_local_git_key "$key" || continue
    if [[ "$entry" == *$'\n'* ]]; then val="${entry#*$'\n'}"; else val=""; bare[$key]=1; fi
    if [ -z "${count[$key]:-}" ]; then
      order+=("$key")
      count[$key]=0
    fi
    count[$key]=$((count[$key] + 1))
    keys+=("$key")
    vals+=("$val")
  done

  for key in "${order[@]}"; do
    if [ -e "$GIT_LOCAL" ] && git config --file "$GIT_LOCAL" --get-all "$key" >/dev/null 2>&1; then
      ok "kept existing $key in ~/.gitconfig.local (not copied from ~/.gitconfig)"
    elif [ -n "${bare[$key]:-}" ]; then
      refuse_git_carry "$key in ~/.gitconfig has no value, which git config cannot copy exactly" || return 1
    else
      todo+=("$key")
    fi
  done
  (( ${#todo[@]} )) || return 0

  if (( DRY_RUN )); then
    for key in "${todo[@]}"; do
      n="${count[$key]}"
      for i in "${!keys[@]}"; do
        [ "${keys[$i]}" = "$key" ] && GIT_PLANNED[$key]="${vals[$i]}"
      done
      ok "would copy $key to ~/.gitconfig.local ($n value$([ "$n" -eq 1 ] || echo s))"
    done
    return 0
  fi

  # Remove the temp file however this ends; the previous traps come back after.
  local traps; traps="$(trap -p EXIT INT TERM)"
  trap 'rm -f -- "$GIT_LOCAL_TMP"' EXIT
  trap 'rm -f -- "$GIT_LOCAL_TMP"; exit 130' INT
  trap 'rm -f -- "$GIT_LOCAL_TMP"; exit 143' TERM
  if ! GIT_LOCAL_TMP="$(mktemp "$GIT_LOCAL.XXXXXX")"; then
    GIT_LOCAL_TMP=""
    trap - EXIT INT TERM; eval "$traps"
    refuse_git_carry "could not create a temp file next to ~/.gitconfig.local" || return 1
  fi
  tmp="$GIT_LOCAL_TMP"
  if ! write_git_local "$tmp"; then
    rm -f -- "$tmp"
    GIT_LOCAL_TMP=""
    trap - EXIT INT TERM; eval "$traps"
    refuse_git_carry "could not write ~/.gitconfig.local (left unchanged)" || return 1
  fi
  GIT_LOCAL_TMP=""
  trap - EXIT INT TERM; eval "$traps"
  for key in "${todo[@]}"; do
    n="${count[$key]}"
    ok "copied $key to ~/.gitconfig.local ($n value$([ "$n" -eq 1 ] || echo s))"
  done
}

# Build the new ~/.gitconfig.local in TMP and move it into place. Reads
# carry_git_local's keys/vals/todo (bash dynamic scope). Returns non-zero, without touching
# ~/.gitconfig.local, if any step fails or TMP doesn't hold exactly the values.
write_git_local() {
  local tmp="$1" key i
  local -a want got
  if [ -e "$GIT_LOCAL" ]; then
    cat -- "$GIT_LOCAL" > "$tmp" || return 1
  fi
  for key in "${todo[@]}"; do
    for i in "${!keys[@]}"; do
      [ "${keys[$i]}" = "$key" ] || continue
      git config --file "$tmp" --add "$key" "${vals[$i]}" || return 1
    done
  done
  for key in "${todo[@]}"; do
    want=()
    for i in "${!keys[@]}"; do
      [ "${keys[$i]}" = "$key" ] && want+=("${vals[$i]}")
    done
    got=()
    mapfile -d '' got < <(git config --file "$tmp" --null --get-all "$key" 2>/dev/null)
    [ "${#got[@]}" -eq "${#want[@]}" ] || return 1
    for i in "${!want[@]}"; do
      [ "${got[$i]}" = "${want[$i]}" ] || return 1
    done
  done
  chmod 600 -- "$tmp" || return 1
  # Rename over a regular file only: never into a directory, never through a
  # link (-T: no target-directory semantics), and check the result.
  local expected; expected="$(cat -- "$tmp")" || return 1
  if [ -L "$GIT_LOCAL" ] || [ -d "$GIT_LOCAL" ]; then
    return 1
  fi
  mv -fT -- "$tmp" "$GIT_LOCAL" || return 1
  [ -f "$GIT_LOCAL" ] && [ ! -L "$GIT_LOCAL" ] && [ "$(cat -- "$GIT_LOCAL")" = "$expected" ]
}

setup_ssh() {
  step "SSH setup"
  run mkdir -p ~/.ssh
  run chmod 700 ~/.ssh
  if [ -f ~/.ssh/id_ed25519 ]; then
    ok "SSH key already exists"
    return 0
  fi
  run ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -N ""
  if (( ! DRY_RUN )); then
    ok "generated ~/.ssh/id_ed25519"
    echo ""
    echo "  Add this public key to GitHub (or wherever needed):"
    cat ~/.ssh/id_ed25519.pub
    echo ""
  fi
}

# Create this run's backup directory on first use. mktemp makes it unique even
# when two runs start in the same second.
ensure_backup_dir() {
  if [ -n "$BACKUP_DIR" ]; then
    return 0
  fi
  local stamp
  stamp="$(date +%Y%m%d-%H%M%S)"
  if (( DRY_RUN )); then
    BACKUP_DIR="$BACKUP_ROOT/$stamp.XXXXXX"
    return 0
  fi
  mkdir -p "$BACKUP_ROOT" || return 1
  BACKUP_DIR="$(mktemp -d "$BACKUP_ROOT/$stamp.XXXXXX")" || { BACKUP_DIR=""; return 1; }
}

# Paths moved to the backup dir this run (under --dry-run: would be moved).
declare -A BACKED_UP=()

# True if $1 or one of its ancestors has been backed up this run.
backed_up() {
  local path="$1"
  while [ "$path" != "$HOME" ] && [ "$path" != / ] && [ "$path" != . ]; do
    [ -n "${BACKED_UP[$path]:-}" ] && return 0
    path="$(dirname "$path")"
  done
  return 1
}

# Move an existing file out of stow's way into $BACKUP_DIR, keeping its path.
# Never overwrites anything already in the backup dir. Returns non-zero, with a
# warning, if the file could not be moved.
backup_file() {
  local target="$1" rel="$2" dest
  if ! ensure_backup_dir; then
    warn "could not create a backup directory under $BACKUP_ROOT; not moving $target"
    return 1
  fi
  dest="$BACKUP_DIR/$rel"
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    warn "backup destination $dest already exists; not moving $target"
    return 1
  fi
  if grep -Eqs "$BLING_PATTERN" "$target"; then
    warn "$target contains the 'ujust bazzite-cli' bling line; it stays in the backup and will NOT be in the stowed file — add it to dotfiles if you want it"
  fi
  if ! run mkdir -p "$(dirname "$dest")"; then
    warn "could not create $(dirname "$dest"); not moving $target"
    return 1
  fi
  if ! run mv -n "$target" "$dest"; then
    warn "could not move $target to $dest"
    return 1
  fi
  if (( ! DRY_RUN )) && { [ -e "$target" ] || [ -L "$target" ] || { [ ! -e "$dest" ] && [ ! -L "$dest" ]; }; }; then
    warn "moving $target to $dest did not take effect"
    return 1
  fi
  BACKED_UP[$target]=1
  BACKUPS+=("$target -> $dest")
  if (( DRY_RUN )); then
    ok "would back up ~/$rel (conflicts with dotfiles)"
  else
    ok "backed up ~/$rel -> $dest"
  fi
}

# True if $1 resolves to a path inside the dotfiles repo. This is repository
# membership only: it does not prove stow made the link. A stow fold qualifies,
# but so does a link made by hand into the repo. Either way the script never
# moves it (anything below it lives in the repo) and leaves it to stow, which
# unfolds a directory link into one of its packages and reports every other
# clash as a conflict (the package is then reported as failed, not forced).
in_repo() {
  local real repo
  real="$(realpath "$1" 2>/dev/null)" || return 1
  repo="$(realpath "$DOTFILES_DIR")"
  [[ "$real" == "$repo"/* ]]
}

# Check one file of a package: back up whatever in $HOME is in its way — the
# target itself, or an ancestor that is a file where the package needs a
# directory. Returns non-zero if the conflict cannot be resolved safely.
resolve_conflict() {
  local pkg_dir="$1" rel="$2" prefix="" part a
  local -a parts
  IFS=/ read -ra parts <<<"$rel"
  for part in "${parts[@]:0:${#parts[@]}-1}"; do
    prefix="${prefix:+$prefix/}$part"
    a="$HOME/$prefix"
    if backed_up "$a"; then
      return 0 # already out of the way (under --dry-run it still exists)
    fi
    if [ -L "$a" ]; then
      if [ "$(realpath "$a" 2>/dev/null)" = "$(realpath "$pkg_dir/$prefix")" ]; then
        return 0 # folded by stow into this package
      elif in_repo "$a"; then
        # Resolves into the repo (a fold into another package, or a link made
        # by hand): stow's to unfold or report. Anything below it lives in the
        # repo, so never move it.
        return 0
      elif [ -d "$a" ]; then
        warn "$a is a symlink to somewhere else; not touching $HOME/$rel — resolve by hand"
        return 1
      fi
      backup_file "$a" "$prefix" || return 1 # link to a file, or dangling
      return 0
    elif [ -e "$a" ] && [ ! -d "$a" ]; then
      backup_file "$a" "$prefix" || return 1 # file where a directory must go
      return 0
    elif [ ! -e "$a" ]; then
      return 0 # nothing below here exists
    fi
  done

  a="$HOME/$rel"
  if [ ! -e "$a" ] && [ ! -L "$a" ]; then
    return 0
  fi
  if backed_up "$a" || [ "$(realpath "$a" 2>/dev/null)" = "$(realpath "$pkg_dir/$rel")" ]; then
    return 0 # already moved, or already stowed
  fi
  if [ -L "$a" ] && in_repo "$a"; then
    return 0 # resolves into the repo (stow's or hand-made): stow's to resolve; it reports clashes
  fi
  backup_file "$a" "$rel" || return 1
}

# A --no-folding package stowed before with folding still has a directory in
# $HOME that is a link to its own directory in the repo, so whatever was
# written there (an installer's links in ~/bin, say) is in the package. Stow
# refuses to unfold a package holding absolute symlinks ("source is an
# absolute symlink") and leaves the fold, so move those out to the backup dir
# first, like any other conflict (never deleted). Returns non-zero if one
# could not be moved.
evict_absolute_links() {
  local pkg_dir="$DOTFILES_DIR/$1" dir rel link sub
  [[ " ${NO_FOLD_PACKAGES[*]} " == *" $1 "* ]] || return 0
  while IFS= read -r -d '' dir; do
    rel="${dir#"$pkg_dir"/}"
    if [ ! -L "$HOME/$rel" ] || [ "$(realpath "$HOME/$rel" 2>/dev/null)" != "$(realpath "$dir")" ]; then
      continue # not folded here
    fi
    while IFS= read -r -d '' link; do
      [[ "$(readlink "$link")" == /* ]] || continue
      sub="$rel/${link#"$dir"/}"
      backup_file "$HOME/$sub" "$sub" || return 1
      warn "absolute symlink ~/$sub, written into the repo through the old ~/$rel fold, goes to the backup dir so ~/$rel can be unfolded; move it back into ~/$rel if you still need it"
    done < <(find "$dir" -type l -print0)
  done < <(find "$pkg_dir" -mindepth 1 -type d -print0)
}

# Back up every file in $HOME that a package would be stowed over. Returns
# non-zero if any conflict could not be resolved (the package is then skipped).
backup_conflicts() {
  local pkg_dir="$DOTFILES_DIR/$1" src
  while IFS= read -r -d '' src; do
    resolve_conflict "$pkg_dir" "${src#"$pkg_dir"/}" || return 1
  done < <(find "$pkg_dir" \( -name .git -o -name 'README*' -o -name 'LICENSE*' -o -name COPYING -o -name .stow-local-ignore -o -name .gitignore \) -prune \
             -o \( -type f -o -type l \) -print0)
}

# True if the git package has a .gitconfig and ~/.gitconfig is a file in its
# way (not already the stowed one, not a link into the repo), i.e. it would be
# backed up.
gitconfig_conflicts() {
  local a="$HOME/.gitconfig"
  [ -e "$DOTFILES_DIR/git/.gitconfig" ] || [ -L "$DOTFILES_DIR/git/.gitconfig" ] || return 1
  [ -f "$a" ] || return 1
  [ "$(realpath "$a" 2>/dev/null)" != "$(realpath "$DOTFILES_DIR/git/.gitconfig")" ] || return 1
  ! in_repo "$a"
}

# Only Bazzite's GNOME session opts into the Linux terminal preference.
prepare_default_terminal() {
  grep -Eq '^ID=("bazzite"|bazzite)$' "$OS_RELEASE_FILE" || return 0
  if [[ ":${XDG_CURRENT_DESKTOP^^}:" != *:GNOME:* ]]; then
    warn "skipped default terminal: GNOME desktop is absent"
    return 0
  fi
  if ! cmd_exists ghostty; then
    warn "skipped default terminal: Ghostty is not available (re-run after reboot if layered)"
    return 0
  fi
  STOW_PACKAGES+=(xdg)
  DEFAULT_TERMINAL=1
}

configure_default_terminal() {
  (( DEFAULT_TERMINAL )) || return 0
  local schema=org.gnome.settings-daemon.plugins.media-keys
  local custom=org.gnome.settings-daemon.plugins.media-keys.custom-keybinding
  local base=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings
  local schemas relocatable raw remaining path binding command i list
  local -a paths=()
  if ! cmd_exists gsettings || ! schemas="$(gsettings list-schemas)" ||
     ! relocatable="$(gsettings list-relocatable-schemas)" ||
     ! grep -Fxq "$schema" <<<"$schemas" || ! grep -Fxq "$custom" <<<"$relocatable"; then
    warn "skipped terminal shortcut: gsettings/GNOME schemas are absent"
    return 0
  fi
  if ! raw="$(gsettings get "$schema" custom-keybindings)"; then
    warn "skipped terminal shortcut: cannot read GNOME custom keybindings"
    return 0
  fi
  # Parse GVariant's array of object paths without eval. Reject unfamiliar
  # output instead of risking replacement of an existing custom binding list.
  remaining="${raw#@as }"
  local array_re="^\[([[:space:]]*'(/[A-Za-z0-9_/-]+/)'[[:space:]]*,?)*[[:space:]]*\]$"
  local path_re="'(/[A-Za-z0-9_/-]+/)'"
  if [[ ! "$remaining" =~ $array_re ]]; then
    warn "skipped terminal shortcut: unrecognised custom keybinding list"
    return 0
  fi
  while [[ "$remaining" =~ $path_re ]]; do
    path="${BASH_REMATCH[1]}"
    paths+=("$path")
    remaining="${remaining#*"${BASH_REMATCH[0]}"}"
  done
  for path in "${paths[@]}"; do
    if ! binding="$(gsettings get "$custom:$path" binding)"; then
      warn "skipped terminal shortcut: cannot read binding at $path"
      return 0
    fi
    if [ "$binding" = "'<Control><Alt>t'" ]; then
      command="$(gsettings get "$custom:$path" command)" || return 1
      if [ "$command" != "'ghostty --gtk-single-instance=true'" ]; then
        run gsettings set "$custom:$path" command "'ghostty --gtk-single-instance=true'"
      else
        ok "Ctrl+Alt+T already opens Ghostty"
      fi
      return 0
    fi
  done
  i=0
  while [[ " ${paths[*]} " == *" $base/custom$i/ "* ]]; do i=$((i + 1)); done
  path="$base/custom$i/"
  run gsettings set "$custom:$path" name "'Terminal'"
  run gsettings set "$custom:$path" binding "'<Control><Alt>t'"
  run gsettings set "$custom:$path" command "'ghostty --gtk-single-instance=true'"
  paths+=("$path")
  list="["
  for path in "${paths[@]}"; do list+="'$path', "; done
  list="${list%, }]"
  run gsettings set "$schema" custom-keybindings "$list"
}

# Stow one package, or only print the command under --dry-run. The single place
# the stow command is built, so a preview shows exactly what a real run runs.
stow_package() {
  local -a stow_flags=()
  # Never --adopt: that would pull existing files into the dotfiles repo.
  if [[ " ${NO_FOLD_PACKAGES[*]} " == *" $1 "* ]]; then stow_flags+=(--no-folding); fi
  run stow "${stow_flags[@]}" --dir="$DOTFILES_DIR" --target="$HOME" --restow "$1"
}

apply_dotfiles() {
  step "Cloning and applying dotfiles"
  if [ ! -d "$HOME_PROJECTS_DIR" ]; then
    run mkdir -p "$HOME_PROJECTS_DIR"
  fi
  clone_if_absent "$DOTFILES_REPO" "$DOTFILES_DIR"
  local pkg
  if [ ! -d "$DOTFILES_DIR" ]; then
    # Only reachable under --dry-run: conflicts are checked once cloned.
    for pkg in "${STOW_PACKAGES[@]}"; do stow_package "$pkg"; done
    GIT_STOWED=1
    RENDER_URL_STOWED=1
    ATUIN_STOWED=1
    return 0
  fi

  cd "$DOTFILES_DIR"
  for pkg in "${STOW_PACKAGES[@]}"; do
    if [ ! -d "$DOTFILES_DIR/$pkg" ]; then
      warn "dotfiles has no '$pkg' package — skipping"
      continue
    fi
    if [ "$pkg" = git ] && gitconfig_conflicts && ! carry_git_local; then
      warn "skipped stowing $pkg"
      continue
    fi
    if ! evict_absolute_links "$pkg" || ! backup_conflicts "$pkg"; then
      warn "skipped stowing $pkg"
      continue
    fi
    if stow_package "$pkg"; then
      if [ "$pkg" = git ]; then GIT_STOWED=1; fi
      if [ "$pkg" = render-url ]; then RENDER_URL_STOWED=1; fi
      if [ "$pkg" = atuin ]; then ATUIN_STOWED=1; fi
      did "stowed $pkg"
    else
      warn "stow failed for $pkg (see output above)"
    fi
  done
}

# Run a command inside directory $1 (a subshell, so the script's cwd is kept),
# or only print it under --dry-run.
run_in() {
  local dir="$1"; shift
  if (( DRY_RUN )); then
    printf "  \033[2m[dry-run]\033[0m (cd %s && %s)\n" "$dir" "$*"
    return 0
  fi
  (cd -- "$dir" && "$@")
}

# Where stow puts the package (and where dotfiles' bin/render-url looks).
RENDER_URL_DIR="$HOME/.local/share/render-url"

# render-url's dependencies (playwright) are not in dotfiles: install them next
# to the stowed files with mise's Node, the way dotfiles' bin/render-url says
# (`npm ci && npx playwright install chromium`). `npm ci` is skipped when
# node_modules was installed from the current package-lock.json (a stamp
# inside node_modules, written only after `npm ci` succeeds, which `npm ci`
# wipes). The browser install always runs: only Playwright knows the exact
# builds it needs (Chromium and its headless shell, at its pinned revision),
# and it skips those it already has, so a failed or stale install is always
# retried on the next run.
install_render_url() {
  local dir="$RENDER_URL_DIR" lock stamp lock_sum=""
  (( RENDER_URL_STOWED )) || return 0
  step "Installing render-url dependencies"
  lock="$dir/package-lock.json"
  stamp="$dir/node_modules/.laptop-package-lock.sha256"
  if (( ! DRY_RUN )) && [ ! -f "$lock" ]; then
    warn "skipped render-url dependencies: $lock not found after stowing"
    return 0
  fi
  if (( ! DRY_RUN )) && in_repo "$dir"; then
    # Still a link into the repo after `stow --restow --no-folding` (which
    # unfolds this package's own folds): npm would write into the repo.
    warn "skipped render-url dependencies: $dir resolves into the dotfiles repo; unstow render-url and re-run so it is stowed with --no-folding"
    return 0
  fi
  if [ -z "$NODE_NPM" ]; then
    warn "skipped render-url dependencies: no usable mise-managed Node (see above). Once Node works: cd $dir && mise exec -- npm ci && mise exec -- npx playwright install chromium"
    return 0
  fi
  if [ -f "$lock" ]; then
    lock_sum="$(sha256sum < "$lock")" || lock_sum=""
  fi
  if [ -n "$lock_sum" ] && [ -d "$dir/node_modules/playwright" ] && [ "$(cat -- "$stamp" 2>/dev/null)" = "$lock_sum" ]; then
    ok "render-url dependencies already installed (package-lock.json unchanged)"
  elif run_in "$dir" "$MISE_BIN" exec -- npm ci; then
    if (( ! DRY_RUN )) && ! { [ -n "$lock_sum" ] && printf '%s\n' "$lock_sum" > "$stamp"; }; then
      warn "could not record render-url's lockfile hash; the next run will run npm ci again"
    fi
    did "installed render-url dependencies (npm ci)"
  else
    warn "'mise exec -- npm ci' failed in $dir; render-url will not work until it succeeds"
    return 0
  fi
  if run_in "$dir" "$MISE_BIN" exec -- npx playwright install chromium; then
    did "Playwright Chromium for render-url is installed (playwright install chromium)"
  else
    warn "'npx playwright install chromium' failed in $dir; render-url cannot launch a browser until it succeeds (retried on the next run)"
  fi
}

# ffmpeg, which dotfiles' bin/transcribe converts audio with: apt on
# Debian/Ubuntu; Bazzite ships /usr/bin/ffmpeg, else Homebrew.
ensure_ffmpeg() { # ensure_ffmpeg debian|atomic
  local -a install=(brew install ffmpeg)
  if [ "$1" = debian ]; then install=(sudo apt-get install -y ffmpeg); fi
  if cmd_exists ffmpeg; then
    ok "ffmpeg already installed ($(command -v ffmpeg))"
  elif run "${install[@]}"; then
    did "installed ffmpeg"
  else
    warn "'${install[*]}' failed; transcribe needs ffmpeg (next run will retry)"
  fi
}

# Which x86_64 release build suits this machine: vulkan when a Vulkan loader
# is present (ldconfig's cache, or the usual lib dirs), else the CPU build for
# the best instruction set /proc/cpuinfo lists.
voxtype_variant() {
  local libs dir
  if cmd_exists ldconfig && libs="$(ldconfig -p 2>/dev/null)" && grep -q 'libvulkan\.so\.1' <<<"$libs"; then
    echo vulkan
    return 0
  fi
  for dir in $VULKAN_LIB_DIRS; do
    if [ -e "$dir/libvulkan.so.1" ]; then
      echo vulkan
      return 0
    fi
  done
  if grep -qw avx512f "$CPUINFO_FILE" 2>/dev/null; then
    echo avx512
  elif grep -qw avx2 "$CPUINFO_FILE" 2>/dev/null; then
    echo avx2
  else
    echo baseline
  fi
}

# Something at $1 that this script must never replace: anything that is not a
# regular file. A symlink counts, whatever it points to.
not_regular_file() { [ -L "$1" ] || { [ -e "$1" ] && [ ! -f "$1" ]; }; }

# Download release asset $1 and install it as $2 (mode 755), only once it is
# verified two ways: SHA256SUMS.txt carries a valid signature made by
# $VOXTYPE_KEY_FPR, and the binary hashes to what SHA256SUMS.txt lists for it.
# gpg gets a temporary GNUPGHOME (the user's keyring is neither read nor
# changed) and --no-autostart (no gpg-agent left running in it). The signature
# is checked before the binary is downloaded. Runs in a subshell, so its temp
# files go when it exits, however it ends. On failure prints why and returns
# non-zero, with $2 untouched.
voxtype_fetch() (
  asset="$1" dest="$2" base="$VOXTYPE_RELEASE" tmp="" new=""
  trap 'rm -rf -- "$tmp" "$new"' EXIT
  fail() { echo "$1"; exit 1; }
  tmp="$(mktemp -d)" || fail "could not create a temp directory"
  export GNUPGHOME="$tmp/gnupg"
  mkdir -m 700 "$GNUPGHOME" || fail "could not create a temporary GNUPGHOME"
  curl -fsSL -o "$tmp/SHA256SUMS.txt" "$base/SHA256SUMS.txt" || fail "could not download $base/SHA256SUMS.txt"
  curl -fsSL -o "$tmp/SHA256SUMS.txt.asc" "$base/SHA256SUMS.txt.asc" || fail "could not download $base/SHA256SUMS.txt.asc"
  curl -fsSL -o "$tmp/key.asc" "$VOXTYPE_KEY_URL" || fail "could not download the signing key from $VOXTYPE_KEY_URL"
  gpg --batch --quiet --no-autostart --import "$tmp/key.asc" >/dev/null 2>&1 || fail "gpg could not import the signing key"
  status="$(gpg --batch --no-autostart --status-fd 1 --verify "$tmp/SHA256SUMS.txt.asc" "$tmp/SHA256SUMS.txt" 2>/dev/null)" ||
    fail "SHA256SUMS.txt has no good GPG signature"
  # Whatever key the server sent, only the pinned one counts: VALIDSIG's last
  # field is the fingerprint of the primary key that made the signature.
  grep -Eq "^\[GNUPG:\] VALIDSIG [0-9A-F]+ .* $VOXTYPE_KEY_FPR\$" <<<"$status" ||
    fail "SHA256SUMS.txt is not signed by $VOXTYPE_KEY_FPR"

  curl -fsSL -o "$tmp/$asset" "$base/$asset" || fail "could not download $base/$asset"
  expected=""
  while read -r sum name; do
    if [ "${name#\*}" = "$asset" ]; then expected="$sum"; fi
  done < "$tmp/SHA256SUMS.txt"
  [[ "$expected" =~ ^[0-9a-f]{64}$ ]] || fail "SHA256SUMS.txt does not list $asset"

  # Staged next to the target and renamed over it: never a half-written
  # binary. The staged copy is the one that is hashed, so the bytes installed
  # are the bytes verified.
  new="$(mktemp "$dest.XXXXXX")" || fail "could not create a temp file next to $dest"
  cp -- "$tmp/$asset" "$new" || fail "could not write next to $dest"
  actual="$(sha256sum < "$new")" || fail "could not hash $asset"
  [ "${actual%% *}" = "$expected" ] || fail "SHA256 mismatch for $asset (expected $expected, got ${actual%% *})"
  chmod 755 -- "$new" || fail "could not write next to $dest"
  # The downloads took a while: look at the target again just before the
  # rename, which would replace a symlink put there in the meantime.
  if not_regular_file "$dest"; then
    fail "$dest became something other than a regular file during the download, so it is left alone"
  fi
  mv -fT -- "$new" "$dest" || fail "could not write $dest"
)

# The Whisper model transcribe uses, and voxtype's config pointing at it.
# `voxtype setup --download` writes a default config whose model is "base.en";
# only that exact generated line is changed, never a model line edited by hand.
# The model counts as downloaded when its file exists; its size and content
# are not checked. LAPTOP_SKIP_VOXTYPE_MODEL=1 skips both.
voxtype_model() { # voxtype_model VOXTYPE_BINARY
  local bin="$1" model cfg
  model="${XDG_DATA_HOME:-$HOME/.local/share}/voxtype/models/ggml-$VOXTYPE_MODEL.bin"
  cfg="${XDG_CONFIG_HOME:-$HOME/.config}/voxtype/config.toml"
  if [ "${LAPTOP_SKIP_VOXTYPE_MODEL:-0}" = 1 ]; then
    ok "skipped the $VOXTYPE_MODEL model and voxtype's config (LAPTOP_SKIP_VOXTYPE_MODEL=1)"
    return 0
  fi
  if [ -f "$model" ]; then
    ok "voxtype model $VOXTYPE_MODEL already downloaded"
  else
    printf "  \033[1;33mnote:\033[0m the %s model is a ~1.6 GB download (LAPTOP_SKIP_VOXTYPE_MODEL=1 skips it)\n" "$VOXTYPE_MODEL"
    if ! run "$bin" setup --download --model "$VOXTYPE_MODEL" --no-post-install --quiet; then
      warn "'voxtype setup --download --model $VOXTYPE_MODEL' failed; next run will retry"
      return 0
    fi
    if (( DRY_RUN )); then
      printf "  \033[2m[dry-run]\033[0m set model = \"%s\" in %s if its model line is the generated \"base.en\"\n" "$VOXTYPE_MODEL" "$cfg"
      return 0
    fi
    if [ ! -f "$model" ]; then
      warn "'voxtype setup --download --model $VOXTYPE_MODEL' did not leave $model; next run will retry"
      return 0
    fi
    ok "downloaded voxtype model $VOXTYPE_MODEL"
  fi
  if [ ! -f "$cfg" ] || [ -L "$cfg" ] || in_repo "$cfg"; then
    return 0 # no config, or one kept in dotfiles: not this script's to edit
  fi
  if ! grep -qx 'model = "base.en"' "$cfg"; then
    ok "voxtype config's model line is not the generated default; left as it is"
  elif run sed -i "s/^model = \"base\\.en\"\$/model = \"$VOXTYPE_MODEL\"/" "$cfg"; then
    did "set model = \"$VOXTYPE_MODEL\" in $cfg (was the generated \"base.en\")"
  else
    warn "could not set model = \"$VOXTYPE_MODEL\" in $cfg"
  fi
}

# voxtype for dotfiles' bin/transcribe, on both platforms: the pinned upstream
# release binary in ~/.local/bin, installed only if missing or another version
# (decided from `voxtype --version`, which writes nothing), then its model.
# Never installed unverified, and never over anything but a regular file.
# Every failure is a warning.
install_voxtype() { # install_voxtype debian|atomic
  step "Installing voxtype $VOXTYPE_VERSION (speech-to-text for transcribe)"
  local dir="$HOME/.local/bin" dest reports="voxtype $VOXTYPE_VERSION" arch asset reason
  dest="$dir/voxtype"
  ensure_ffmpeg "$1"
  arch="$(uname -m 2>/dev/null)" || arch=unknown
  if [ "$arch" != x86_64 ]; then
    warn "skipped voxtype: only its x86_64 release binaries are installed here (this machine is $arch)"
    return 0
  fi
  if not_regular_file "$dest"; then
    warn "skipped voxtype: $dest is not a regular file, so it is left alone (move it away to get voxtype $VOXTYPE_VERSION)"
    return 0
  fi
  if [ -f "$dest" ] && [ "$("$dest" --version 2>/dev/null)" = "$reports" ]; then
    ok "voxtype $VOXTYPE_VERSION already installed ($dest)"
  elif in_repo "$dir"; then
    warn "skipped voxtype: $dir resolves into the dotfiles repo"
    return 0
  elif (( ! DRY_RUN )) && ! cmd_exists gpg; then
    warn "skipped voxtype: gpg not found, so the release's signature can't be checked, and nothing is installed unverified. Install gpg and re-run"
    return 0
  else
    asset="voxtype-$VOXTYPE_VERSION-linux-x86_64-$(voxtype_variant)"
    if (( DRY_RUN )); then
      printf "  \033[2m[dry-run]\033[0m download %s (with SHA256SUMS.txt and SHA256SUMS.txt.asc)\n" "$VOXTYPE_RELEASE/$asset"
      printf "  \033[2m[dry-run]\033[0m verify SHA256SUMS.txt's GPG signature against %s (key from keys.openpgp.org, temporary GNUPGHOME) and the binary's SHA256\n" "$VOXTYPE_KEY_FPR"
      printf "  \033[2m[dry-run]\033[0m install it as %s (mode 755)\n" "$dest"
    elif ! mkdir -p "$dir"; then
      warn "could not create $dir; voxtype not installed"
      return 0
    elif ! reason="$(voxtype_fetch "$asset" "$dest")"; then
      warn "voxtype not installed: $reason. Nothing was installed; next run will retry"
      return 0
    elif [ "$("$dest" --version 2>/dev/null)" != "$reports" ]; then
      warn "$asset was verified and installed, but $dest does not report '$reports'; not downloading its model"
      return 0
    else
      ok "installed $asset as $dest (GPG signature and SHA256 verified)"
    fi
  fi
  voxtype_model "$dest"
}

# The version `$1 --version` reports ("NVIM v0.12.5" gives 0.12.5), or nothing
# if it can't be run or its first line isn't of that form. NVIM_LOG_FILE:
# without it even `nvim --version` creates ~/.local/state/nvim/nvim.log.
nvim_version() {
  local out
  out="$(NVIM_LOG_FILE=/dev/null "$1" --version 2>/dev/null)" || return 0
  if [[ "${out%%$'\n'*}" =~ ^NVIM\ v([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
    echo "$((10#${BASH_REMATCH[1]})).$((10#${BASH_REMATCH[2]})).$((10#${BASH_REMATCH[3]}))"
  fi
}

# True if version $1 is at least $2 (both MAJOR.MINOR.PATCH), compared number
# by number: 0.9.5 is older than 0.12.0, which comparing strings gets wrong.
version_at_least() {
  local -a have want
  local i
  IFS=. read -r -a have <<<"$1"
  IFS=. read -r -a want <<<"$2"
  for i in 0 1 2; do
    if (( have[i] > want[i] )); then return 0; fi
    if (( have[i] < want[i] )); then return 1; fi
  done
  return 0
}

# The nvim that the shells dotfiles set up will run: its .bashrc and .zshrc
# put ~/bin and ~/.local/bin first on PATH, ahead of /usr/bin (apt's nvim).
dotfiles_nvim() { PATH="$HOME/bin:$HOME/.local/bin:$PATH" command -v nvim; }

# Download the pinned release tarball and unpack it as $1, only once its
# SHA256 is the pinned one. Unpacked next to $1 and renamed into place: never
# a half-unpacked tree. Runs in a subshell, so its temp files go when it
# exits, however it ends. On failure prints why and returns non-zero, with
# nothing left at $1.
neovim_fetch() (
  dest="$1" tmp="" new=""
  trap 'rm -rf -- "$tmp" "$new"' EXIT
  fail() { echo "$1"; exit 1; }
  tmp="$(mktemp -d)" || fail "could not create a temp directory"
  curl -fsSL -o "$tmp/$NEOVIM_ASSET" "$NEOVIM_RELEASE/$NEOVIM_ASSET" || fail "could not download $NEOVIM_RELEASE/$NEOVIM_ASSET"
  actual="$(sha256sum < "$tmp/$NEOVIM_ASSET")" || fail "could not hash $NEOVIM_ASSET"
  [ "${actual%% *}" = "$NEOVIM_SHA256" ] || fail "SHA256 mismatch for $NEOVIM_ASSET (expected $NEOVIM_SHA256, got ${actual%% *})"
  new="$(mktemp -d "$dest.XXXXXX")" || fail "could not create a temp directory next to $dest"
  tar -xzf "$tmp/$NEOVIM_ASSET" -C "$new" --strip-components=1 || fail "could not unpack $NEOVIM_ASSET"
  [ "$(nvim_version "$new/bin/nvim")" = "$NEOVIM_VERSION" ] || fail "the unpacked $NEOVIM_ASSET does not report Neovim $NEOVIM_VERSION"
  chmod 755 -- "$new" || fail "could not write next to $dest"
  mv -T -- "$new" "$dest" || fail "could not move the unpacked $NEOVIM_ASSET to $dest"
)

# Debian/Ubuntu only (Bazzite's comes from Homebrew): a Neovim new enough for
# the dotfiles config. Nothing is done when the nvim that dotfiles' shells
# resolve (see dotfiles_nvim) is already at least $NEOVIM_MIN. Otherwise the
# pinned upstream release is unpacked into ~/.local/share/laptop and linked as
# ~/.local/bin/nvim, which comes before apt's /usr/bin/nvim in those shells.
# A version that can't be read counts as too old. Every failure is a warning.
install_neovim() {
  step "Installing Neovim $NEOVIM_VERSION (the dotfiles config needs >= $NEOVIM_MIN)"
  local dir="$HOME/.local/bin" dest="$HOME/.local/share/laptop/nvim-$NEOVIM_VERSION"
  local current version found still arch reason
  current="$(dotfiles_nvim)" || current=""
  version="$(nvim_version "$current")"
  if [ -z "$current" ]; then
    found="no nvim found"
  elif [ -z "$version" ]; then
    found="$current reports no version that can be read ('$current --version'), so it counts as too old"
  elif version_at_least "$version" "$NEOVIM_MIN"; then
    ok "nvim $version already installed ($current)"
    return 0
  else
    found="$current is $version, older than $NEOVIM_MIN"
  fi
  printf "  \033[2mnote:\033[0m %s\n" "$found"
  still="$found, and the dotfiles config needs >= $NEOVIM_MIN"
  arch="$(uname -m 2>/dev/null)" || arch=unknown
  if [ "$arch" != x86_64 ]; then
    warn "skipped Neovim $NEOVIM_VERSION: only its x86_64 release tarball is installed here (this machine is $arch); $still"
    return 0
  fi
  # Without the clone (a fresh machine's --dry-run) nothing can resolve into it.
  if [ -d "$DOTFILES_DIR" ] && in_repo "$dir"; then
    warn "skipped Neovim $NEOVIM_VERSION: $dir resolves into the dotfiles repo; $still"
    return 0
  fi
  if [ "$(nvim_version "$dest/bin/nvim")" = "$NEOVIM_VERSION" ]; then
    ok "Neovim $NEOVIM_VERSION already unpacked ($dest)"
  elif [ -e "$dest" ] || [ -L "$dest" ]; then
    warn "Neovim $NEOVIM_VERSION not installed: $dest exists but holds no working Neovim $NEOVIM_VERSION, so it is left alone (move it away and re-run); $still"
    return 0
  elif (( DRY_RUN )); then
    printf "  \033[2m[dry-run]\033[0m download %s\n" "$NEOVIM_RELEASE/$NEOVIM_ASSET"
    printf "  \033[2m[dry-run]\033[0m verify its SHA256 against the pinned %s\n" "$NEOVIM_SHA256"
    printf "  \033[2m[dry-run]\033[0m unpack it into %s\n" "$dest"
  elif ! mkdir -p "$dir" "$(dirname "$dest")"; then
    warn "Neovim $NEOVIM_VERSION not installed: could not create $dir or $(dirname "$dest"); $still"
    return 0
  elif ! reason="$(neovim_fetch "$dest")"; then
    warn "Neovim $NEOVIM_VERSION not installed: $reason. Nothing was installed; $still (next run will retry)"
    return 0
  else
    ok "installed Neovim $NEOVIM_VERSION in $dest (SHA256 verified)"
  fi
  link_local_bin "$dest/bin/nvim" "$dir/nvim"
  if (( DRY_RUN )); then
    return 0
  fi
  # What counts is what `nvim` now runs, not that the steps above went through.
  current="$(dotfiles_nvim)" || current=""
  version="$(nvim_version "$current")"
  if [ -n "$version" ] && version_at_least "$version" "$NEOVIM_MIN"; then
    ok "nvim is now $version ($current)"
  else
    warn "Neovim is not ready: nvim still resolves to ${current:-nothing} (${version:-no readable version}), and the dotfiles config needs >= $NEOVIM_MIN. Check $dir/nvim and anything named nvim in ~/bin"
  fi
}

run_local() {
  if [ -f ~/.laptop.local ]; then
    step "Running ~/.laptop.local"
    if (( DRY_RUN )); then
      printf "  \033[2m[dry-run]\033[0m source ~/.laptop.local\n"
    else
      # shellcheck source=/dev/null
      source ~/.laptop.local
    fi
  else
    printf "\n  No ~/.laptop.local found — skipping personal additions.\n"
    printf "  Create one to clone private repos, add bin symlinks, etc.\n"
  fi
}

summary() {
  step "Summary"
  local line
  if (( ${#BACKUPS[@]} )); then
    printf "  Backed up (conflicted with dotfiles; nothing was adopted):\n"
    for line in "${BACKUPS[@]}"; do printf "    %s\n" "$line"; done
  fi
  if (( ${#WARNINGS[@]} )); then
    printf "  Warnings:\n"
    for line in "${WARNINGS[@]}"; do printf "    ! %s\n" "$line"; done
  fi
  # The atuin package installs a Quadlet unit; this script never starts it.
  # atuin-ai-server needs llama-swap on :8080 (see the dotfiles README).
  if (( ATUIN_STOWED )) && cmd_exists podman; then
    printf "  To start Atuin AI's server (needs llama-swap on :8080): systemctl --user daemon-reload && systemctl --user start atuin-ai-server\n"
  fi
  if (( ${#REBOOT_PKGS[@]} )); then
    printf "\n  \033[1;33mReboot required\033[0m to use layered packages: %s\n" "${REBOOT_PKGS[*]}"
    printf "  Run 'systemctl reboot' when convenient — this script never reboots.\n"
  fi
  if (( DRY_RUN )); then
    printf "\n\033[1;32mDry run complete.\033[0m Nothing was changed.\n\n"
  fi
}

# ── Pop_OS / Ubuntu / Debian ─────────────────────────────────────────────────

install_debian() {
  step "Updating system packages"
  run sudo apt-get update -qq
  run sudo apt-get upgrade -y

  step "Installing core packages"
  apt_install \
    build-essential \
    curl \
    gpg \
    wget \
    git \
    git-delta \
    stow \
    zsh \
    neovim \
    jq \
    ripgrep \
    fd-find \
    fzf \
    bat \
    xclip \
    tmux \
    shellcheck \
    openjdk-21-jdk \
    zsh-autosuggestions \
    zsh-syntax-highlighting
  # apt's neovim is too old for the dotfiles config (Ubuntu 24.04: 0.9.5); it
  # stays as /usr/bin/nvim for root and as the fallback, and install_neovim
  # puts a new enough one ahead of it on PATH.
  # No gitleaks: Ubuntu 24.04's package is 8.16.0, and dotfiles' pre-commit
  # hook needs >= 8.20.0 (it skips the scan with a warning without one).

  step "Installing gh CLI"
  if cmd_exists gh; then
    ok "gh already installed ($(gh --version | head -1))"
  else
    run_sh "curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg"
    run sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
    run_sh "echo \"deb [arch=\$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main\" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null"
    run sudo apt-get update -qq
    run sudo apt-get install -y gh
    did "installed gh"
  fi

  step "Installing mise"
  if [ -n "$(find_mise)" ]; then
    ok "mise already installed ($(find_mise))" # not run: mise creates state
  else
    # mise's official apt repo: signed packages that `apt-get upgrade` keeps
    # current, set up the same way as the gh repo above.
    run sudo install -dm 755 /etc/apt/keyrings
    # The key is dearmored to a temp file first, so a failed download never
    # leaves an empty keyring behind; both files are made apt-readable (0644).
    run_sh "tmp=\$(mktemp) && trap 'rm -f \"\$tmp\"' EXIT && curl -fsSL https://mise.jdx.dev/gpg-key.pub | gpg --dearmor > \"\$tmp\" && sudo install -m 644 \"\$tmp\" /etc/apt/keyrings/mise-archive-keyring.gpg"
    run_sh "echo \"deb [signed-by=/etc/apt/keyrings/mise-archive-keyring.gpg arch=\$(dpkg --print-architecture)] https://mise.jdx.dev/deb stable main\" | sudo tee /etc/apt/sources.list.d/mise.list > /dev/null"
    run sudo chmod 644 /etc/apt/sources.list.d/mise.list
    run sudo apt-get update -qq
    run sudo apt-get install -y mise
    did "installed mise"
  fi
  install_node
  install_agent_clis
  install_salesforce
  install_bun

  step "Installing uv"
  if cmd_exists uv; then
    ok "uv already installed"
  else
    run_sh "curl -LsSf https://astral.sh/uv/install.sh | sh"
    did "installed uv"
  fi

  step "Installing Starship prompt"
  if cmd_exists starship; then
    ok "starship already installed"
  else
    run_sh "curl -sS https://starship.rs/install.sh | sh -s -- --yes"
    did "installed starship"
  fi

  install_font

  step "Installing Ghostty"
  if cmd_exists ghostty; then
    ok "ghostty already installed ($(ghostty --version | head -1))"
  else
    run_sh "/bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/mkasberg/ghostty-ubuntu/HEAD/install.sh)\""
    did "installed ghostty"
  fi

  step "Disabling telemetry"
  if cmd_exists ubuntu-report; then
    run ubuntu-report send no 2>/dev/null || true
  fi
  if dpkg -s popularity-contest &>/dev/null 2>&1; then
    run sudo apt-get remove -y popularity-contest
  fi
  run sudo systemctl disable apport 2>/dev/null || true
  if cmd_exists go; then
    run go telemetry off 2>/dev/null || true
  fi
  npm_no_fund
  ok "telemetry disabled"

  setup_ssh
  apply_dotfiles
  install_render_url
  install_neovim
  install_voxtype debian
  configure_git

  step "Setting zsh as default shell"
  local zsh_path
  zsh_path="$(command -v zsh || echo /usr/bin/zsh)"
  if [ "${SHELL:-}" = "$zsh_path" ]; then
    ok "zsh is already the default shell"
  else
    run chsh -s "$zsh_path"
    did "default shell set to zsh (takes effect on next login)"
  fi
}

# ── Bazzite / Fedora Atomic ──────────────────────────────────────────────────
# Install-order rule: ujust recipe (only if it does exactly the job and leaves
# stowed files alone) > Homebrew (CLI) > Flatpak (GUI) > rpm-ostree (last resort).
# /usr is read-only, so nothing here uses sudo, apt, chsh or system keyrings.

ensure_brew() {
  if cmd_exists brew; then
    return 0
  fi
  local dir
  for dir in $BREW_DIRS; do
    if [ -x "$dir/bin/brew" ]; then
      eval "$("$dir/bin/brew" shellenv)"
      return 0
    fi
  done
  if (( DRY_RUN )); then
    warn "Homebrew not found — a real run stops here. Bazzite ships it; otherwise install it from https://brew.sh first"
    BREW_MISSING=1
    return 0
  fi
  die "Homebrew not found. Bazzite ships it; otherwise install it from https://brew.sh and re-run."
}

install_brew_formulae() {
  step "Installing CLI tools with Homebrew"
  local entry formula bin missing=()
  for entry in "${BREW_FORMULAE[@]}"; do
    formula="${entry%%:*}"
    bin="${entry#*:}"
    if (( BREW_MISSING )); then
      missing+=("$formula") # only reachable under --dry-run
    elif brew list --formula --versions "$formula" &>/dev/null; then
      ok "$formula already installed (brew)"
    elif [ -n "$bin" ] && cmd_exists "$bin"; then
      ok "$formula provided by the system ($(command -v "$bin")) — skipping"
    else
      missing+=("$formula")
    fi
  done
  if (( ${#missing[@]} )); then
    run brew install "${missing[@]}"
    did "installed ${missing[*]}"
  fi
}

# Which deployment in `rpm-ostree status --json` ($2) layers package $1:
# prints "booted", "pending" (a staged/pending deployment newer than the booted
# one) or nothing. Rollback deployments (older than the booted one) don't count.
# If the JSON cannot be read, prints nothing, so the caller falls back to
# `rpm-ostree install --idempotent`, which is a no-op for requested packages.
deployment_with() {
  cmd_exists python3 || return 0
  python3 -c '
import json, sys
pkg = sys.argv[1]
try:
    deps = json.load(sys.stdin)["deployments"]
    assert isinstance(deps, list) and all(isinstance(d, dict) for d in deps)
except Exception:
    sys.exit(0)
booted = next((i for i, d in enumerate(deps) if d.get("booted")), None)
if booted is None:
    sys.exit(0)
def has(d):
    return pkg in (d.get("requested-packages") or []) + (d.get("packages") or [])
if has(deps[booted]):
    print("booted")
elif any(has(d) for d in deps[:booted]):
    print("pending")
' "$1" <<<"$2" 2>/dev/null || true
}

# Layer LAYERED_PACKAGES in one rpm-ostree transaction. Never reboots.
layer_packages() {
  step "Layering packages with rpm-ostree (${LAYERED_PACKAGES[*]})"
  local pkg status_json where pending=()
  status_json="$(rpm-ostree status --json 2>/dev/null || true)"
  for pkg in "${LAYERED_PACKAGES[@]}"; do
    where="$(deployment_with "$pkg" "$status_json")"
    if rpm -q "$pkg" &>/dev/null || cmd_exists "$pkg" || [ "$where" = booted ]; then
      ok "$pkg already installed"
    elif [ "$where" = pending ]; then
      ok "$pkg already layered — active after the next reboot"
      REBOOT_PKGS+=("$pkg")
    else
      pending+=("$pkg")
    fi
  done
  if (( ! ${#pending[@]} )); then
    return 0
  fi
  if ! compgen -G "$YUM_REPOS_DIR/terra*.repo" >/dev/null; then
    warn "Terra repo not found in $YUM_REPOS_DIR — rpm-ostree may not find: ${pending[*]}"
  fi
  if run rpm-ostree install --idempotent "${pending[@]}"; then
    REBOOT_PKGS+=("${pending[@]}")
    did "layered ${pending[*]}"
  else
    warn "rpm-ostree install failed for: ${pending[*]}. If the error mentions Terra metadata or checksum mismatches, a mirror is stale: run 'rpm-ostree refresh-md --force' and re-run this script. Not retrying automatically."
  fi
}

install_atomic() {
  step "System update"
  ok "skipped — Bazzite updates its image itself (run 'ujust update' to force)"

  ensure_brew
  install_brew_formulae

  install_node
  install_agent_clis
  install_salesforce
  install_bun

  install_font
  layer_packages

  step "Disabling telemetry"
  if cmd_exists go; then
    run go telemetry off 2>/dev/null || true
  fi
  npm_no_fund
  ok "telemetry disabled"

  setup_ssh
  prepare_default_terminal
  apply_dotfiles
  install_render_url
  install_voxtype atomic
  configure_default_terminal
  configure_git

  step "Login shell"
  ok "login shell stays bash (no chsh on Bazzite); Ghostty starts zsh via its 'command =' setting"
  local ghostty_conf
  for ghostty_conf in "$DOTFILES_DIR"/ghostty/.config/ghostty/config*; do
    if [ -f "$ghostty_conf" ] && ! grep -Eq '^[[:space:]]*command[[:space:]]*=' "$ghostty_conf"; then
      warn "${ghostty_conf#"$DOTFILES_DIR"/} has no 'command =' line — add 'command = ${HOMEBREW_PREFIX:-/home/linuxbrew/.linuxbrew}/bin/zsh' in dotfiles"
    fi
  done
}

# ── Main ─────────────────────────────────────────────────────────────────────

main() {
  local print_os=0 arg os
  for arg in "$@"; do
    case "$arg" in
      -n|--dry-run) DRY_RUN=1 ;;
      --print-os)   print_os=1 ;;
      -h|--help)    usage; exit 0 ;;
      *)            usage >&2; die "unknown option: $arg" ;;
    esac
  done

  os="$(detect_os)"
  if (( print_os )); then
    echo "$os"
    return 0
  fi
  if (( DRY_RUN )); then
    printf "\033[1;33mDry run:\033[0m printing the plan; nothing will be changed.\n"
  fi

  case "$os" in
    debian) printf "Detected Debian/Ubuntu/Pop!_OS — using apt.\n"; install_debian ;;
    atomic) printf "Detected Bazzite / Fedora Atomic — using Homebrew, rpm-ostree only for: %s\n" "${LAYERED_PACKAGES[*]}"; install_atomic ;;
    *)      die "unsupported platform (${os#unsupported:}); supported: Ubuntu/Pop!_OS/Debian, Bazzite/Fedora Atomic" ;;
  esac

  run_local
  check_git_identity
  summary

  if (( ! DRY_RUN )); then
    if [ "$os" = debian ]; then
      printf "\n\033[1;32mDone.\033[0m Log out and back in to start using zsh.\n\n"
    else
      printf "\n\033[1;32mDone.\033[0m Open Ghostty to start using zsh.\n\n"
    fi
  fi
}

main "$@"
